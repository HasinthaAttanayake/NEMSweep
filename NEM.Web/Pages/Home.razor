@page "/"
@using NEM.Contracts
@using NEM.Web.Components.Viz
@using NEM.Web.Services
@using NEM.Web.Services.Insights
@inject ArtifactLoader ArtifactLoader
@inject SweepManifestLoader SweepManifestLoader
@inject SweepIndexLoader SweepIndexLoader

<PageTitle>NemSim</PageTitle>

<div class="home-page">
    <header class="project-header">
        <p class="eyebrow">Open National Electricity Market simulation</p>
        <h1>NemSim</h1>
        <p class="lead">
            An open model of Australia's National Electricity Market, being built in public one
            validated layer at a time.
        </p>
        <div class="project-actions">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Href="https://github.com/users/HasinthaAttanayake/projects/11"
                       Target="_blank"
                       rel="noopener noreferrer"
                       StartIcon="@Icons.Material.Filled.TrackChanges">
                Track project
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Href="https://github.com/HasinthaAttanayake/NemSim"
                       Target="_blank"
                       rel="noopener noreferrer"
                       StartIcon="@Icons.Material.Filled.Code">
                View source
            </MudButton>
        </div>
    </header>

    @if (_system is not null && _analysis is not null)
    {
        <section class="headline-section" aria-labelledby="headline-heading">
            <div class="section-heading">
                <div>
                    <p class="section-label">Latest run</p>
                    <h2 id="headline-heading">What the current simulation costs</h2>
                </div>
                <p>@ScopeSentence</p>
            </div>

            <MetricStrip Items="@HeadlineMetrics" AriaLabel="Current run headline figures"
                         Style="--metric-value-size: 1.5rem;" />

            @if (_analysis.SystemMix.TotalMwh > 0)
            {
                <div class="headline-mix">
                    <MixBar Segments="@_analysis.SystemMix.Segments()"
                            Label="Delivered energy by technology"
                            Detail="@($"{PlotFormat.Compact(_analysis.SystemMix.TotalMwh)} MWh delivered")"
                            AriaLabel="System delivered generation by technology" />
                </div>
            }

            <div class="headline-links">
                <a href="regions">Compare the states</a>
                <a href="dispatch">Open the hourly dispatch</a>
            </div>
        </section>

        <FindingCards Findings="@_analysis.Findings"
                      Eyebrow="Read this first"
                      Heading="What the current run found"
                      Description="Generated from the run's own figures each time this page loads, not written by hand. The most significant are shown here; the comparison page carries them all with the tables behind them."
                      Limit="3"
                      EvidenceHref="regions"
                      EvidenceText="See the figures behind this"
                      Class="home-findings" />
    }
    else if (_systemState.Status is ArtifactLoadStatus.Loading)
    {
        <section class="headline-section">
            <div class="status-block"><MudProgressCircular Color="Color.Primary" Indeterminate="true" /></div>
        </section>
    }

    @* What the model can do, read out of the artifacts rather than described in prose, so this
       section moves when the model does instead of going quietly stale. *@
    @if (_modelState is not null)
    {
        <section class="state-section" aria-labelledby="state-heading">
            <div class="section-heading">
                <div>
                    <p class="section-label">Where the build is</p>
                    <h2 id="state-heading">What the model does today</h2>
                </div>
                <p>
                    NemSim is built one validated layer at a time. Every line below is read from the
                    artifacts the latest run produced, so this list is current by construction.
                </p>
            </div>

            <ul class="capabilities">
                @foreach (ModelCapability capability in _modelState.Capabilities)
                {
                    <li class="@(capability.IsPresent ? "is-present" : "is-absent")">
                        <MudIcon Icon="@(capability.IsPresent ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked)"
                                 Size="Size.Small" />
                        <span>
                            <strong>@capability.Name</strong>
                            <small>@capability.Detail</small>
                        </span>
                    </li>
                }
            </ul>

            <p class="schema-line">
                Artifact schemas in this build:
                @string.Join(" · ", _modelState.SchemaVersions.Select(entry => $"{entry.Key} v{entry.Value}"))
            </p>
        </section>
    }

    <section class="question-section">
        <div>
            <p class="section-label">Research focus</p>
            <h2>Questions the model is built to test</h2>
        </div>

        <ol>
            <li>What could electricity cost in 2030 if Australia achieves its 82% renewable generation target?</li>
            <li>
                How could data-centre growth affect that outcome under the Australian Government's
                <a href="https://www.industry.gov.au/publications/expectations-data-centres-and-ai-infrastructure-developers"
                   target="_blank"
                   rel="noopener noreferrer">expectations for developers</a>?
            </li>
        </ol>
    </section>

    @* An empty manifest legitimately means "no sweeps yet" and the section is omitted. A manifest
       that could not be read is different, and says so rather than quietly hiding navigation. *@
    @if (_manifestState.Status is ArtifactLoadStatus.Failed or ArtifactLoadStatus.InvalidData
        or ArtifactLoadStatus.NotFound)
    {
        <section class="explore-section">
            <div class="section-heading">
                <div>
                    <p class="section-label">Scenario sweeps</p>
                    <h2>Compare runs across one varying input</h2>
                </div>
            </div>
            <ArtifactLoadStateView State="_manifestState"><span /></ArtifactLoadStateView>
        </section>
    }
    else if (_sweeps.Count > 0)
    {
        <section class="explore-section">
            <div class="section-heading">
                <div>
                    <p class="section-label">Scenario sweeps</p>
                    <h2>Compare runs across one varying input</h2>
                </div>
                <p>
                    Each sweep holds the whole scenario constant and moves one input. The headline is
                    what that input bought, and what it cost.
                </p>
            </div>

            <div class="sweep-cards">
                @foreach (SweepSummary summary in _sweeps)
                {
                    <a class="sweep-card" href="@SweepPaths.PageRoute(summary.Index.SweepId)">
                        <p class="sweep-card-kind">@summary.Index.Axis.Label · @summary.Index.Axis.Unit</p>
                        <h3>@summary.Index.Name</h3>
                        @if (summary.Analysis.Findings.Count > 0)
                        {
                            <p class="sweep-card-finding">@summary.Analysis.Findings[0].Headline</p>
                        }
                        <dl class="sweep-card-facts">
                            <div>
                                <dt>Runs</dt>
                                <dd>@summary.Index.Points.Length.ToString("N0")</dd>
                            </div>
                            @if (summary.Analysis.First is { } first && summary.Analysis.Last is { } last)
                            {
                                <div>
                                    <dt>Levelised cost</dt>
                                    <dd>@PlotFormat.Money(first.Scalars.SlcoeAudPerMwh) → @PlotFormat.Money(last.Scalars.SlcoeAudPerMwh)</dd>
                                </div>
                                <div>
                                    <dt>Annual cost</dt>
                                    <dd>@PlotFormat.MoneyTotal((decimal)first.TotalAnnualCostAud) → @PlotFormat.MoneyTotal((decimal)last.TotalAnnualCostAud)</dd>
                                </div>
                            }
                            @if (summary.Analysis.ConstrainedPoints.Count > 0)
                            {
                                <div class="sweep-card-constraint">
                                    <dt>Without results</dt>
                                    <dd>@summary.Analysis.ConstrainedPoints.Count.ToString("N0") runs</dd>
                                </div>
                            }
                        </dl>
                        <span class="sweep-card-open">
                            Open the sweep
                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                        </span>
                    </a>
                }
            </div>
        </section>
    }

    <section class="explore-section">
        <div class="section-heading">
            <div>
                <p class="section-label">Trace it back</p>
                <h2>Every result rests on a published input</h2>
            </div>
            <p>
                Each result on this site names the exact artifact bytes it was computed from. These
                are those inputs, and the method behind them.
            </p>
        </div>

        <div class="explore-links">
            <a href="regions">
                <MudIcon Icon="@Icons.Material.Filled.Map" />
                <span>
                    <strong>System and states</strong>
                    <small>Where the cost, the spill and the shortfall actually sit</small>
                </span>
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
            </a>
            <a href="dispatch">
                <MudIcon Icon="@Icons.Material.Filled.AreaChart" />
                <span>
                    <strong>Hourly dispatch</strong>
                    <small>Generation, storage, reliability, and annual system cost</small>
                </span>
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
            </a>
            <a href="inputs/demand">
                <MudIcon Icon="@Icons.Material.Filled.ElectricBolt" />
                <span>
                    <strong>Operational demand</strong>
                    <small>Actual demand by year, month, or day</small>
                </span>
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
            </a>
            <a href="inputs/weather">
                <MudIcon Icon="@Icons.Material.Filled.WbSunny" />
                <span>
                    <strong>Weather resources</strong>
                    <small>Solar, wind, temperature, and modelled generation</small>
                </span>
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
            </a>
            <a href="inputs/generation">
                <MudIcon Icon="@Icons.Material.Filled.Factory" />
                <span>
                    <strong>Generation fleet</strong>
                    <small>Installed capacity and source units by technology</small>
                </span>
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
            </a>
            <a href="solar-zenith">
                <MudIcon Icon="@Icons.Material.Filled.ShowChart" />
                <span>
                    <strong>Solar geometry</strong>
                    <small>Hourly solar zenith for the weather location</small>
                </span>
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
            </a>
        </div>
    </section>
</div>

@code {
    private List<SweepSummary> _sweeps = [];
    private ArtifactLoadState _manifestState = ArtifactLoadState.Loading();
    private ArtifactLoadState _systemState = ArtifactLoadState.Loading();
    private SystemDispatchResultsDTO? _system;
    private SystemAnalysis? _analysis;
    private ModelState? _modelState;

    private string ScopeSentence => _system is null
        ? string.Empty
        : $"{string.Join(" and ", _system.RegionIds.Select(RegionNames.State))}, "
            + $"{_system.PeriodStart:MMM yyyy} to {_system.PeriodEnd.AddTicks(-1):MMM yyyy}, "
            + $"simulated at {_system.Resolution.TotalHours:N0}-hour resolution against a typical "
            + "meteorological year.";

    private IReadOnlyList<MetricStripItem> HeadlineMetrics => _analysis is null
        ?
        []
        :
        [
            new("Levelised cost", PlotFormat.Money(_analysis.Result.Cost.SlcoeAudPerMwh), "AUD/MWh served"),
            new("Annual system cost", PlotFormat.MoneyTotal(_analysis.Result.Cost.TotalAnnualisedCostAud), "generation, storage and transmission"),
            new("Renewable share", RenewableShare, "of delivered energy"),
            new(
                "Reliability",
                _analysis.Result.Reliability.WithinTarget ? "Within target" : "Outside target",
                $"{PlotFormat.Share(AllowanceUsed, 0)} of the unserved-energy allowance used"),
        ];

    private string RenewableShare => _analysis!.SystemMix.TotalMwh > 0
        ? PlotFormat.Share(_analysis.SystemMix.RenewableShare)
        : "—";

    private double AllowanceUsed => _analysis!.Result.Reliability.TargetUsePercentageOfDemand <= 0
        ? 0
        : _analysis.Result.Reliability.AchievedUsePercentageOfDemand
            / _analysis.Result.Reliability.TargetUsePercentageOfDemand;

    protected override async Task OnInitializedAsync()
    {
        // The system result is what the page leads with, so it is fetched first and rendered before
        // the sweep indexes are walked.
        ArtifactLoadResult<SystemDispatchResultsDTO> system =
            await ArtifactLoader.LoadAsync<SystemDispatchResultsDTO>("data/results.json");
        _systemState = system.State;
        if (system.IsSuccess)
        {
            _system = system.Value!;
            _analysis = SystemAnalysis.Build(_system);
            StateHasChanged();
        }

        ArtifactLoadResult<SweepManifestDTO> manifest = await SweepManifestLoader.LoadAsync();
        _manifestState = manifest.State;
        if (!manifest.IsSuccess)
        {
            return;
        }

        foreach (SweepManifestEntryDTO entry in manifest.Value!.Sweeps)
        {
            ArtifactLoadResult<SweepIndexDTO> index =
                await SweepIndexLoader.LoadAsync(SweepPaths.IndexPath(entry));
            if (index.IsSuccess)
            {
                _sweeps.Add(new SweepSummary(index.Value!, SweepAnalysis.Build(index.Value!)));
            }
        }

        // Stated once both halves are in hand: what the model does is partly a question about the
        // dispatch run and partly about how many sweeps sit behind it.
        if (_system is not null)
        {
            _modelState = ModelState.From(_system, [.. _sweeps.Select(sweep => sweep.Index)]);
        }
    }

    private sealed record SweepSummary(SweepIndexDTO Index, SweepAnalysis Analysis);
}
