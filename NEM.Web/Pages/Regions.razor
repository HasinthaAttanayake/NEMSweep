    private string SystemDelta(RegionProfile region)
    {
        decimal delta = region.Cost.SlcoeAudPerMwh - _analysis!.Result.Cost.SlcoeAudPerMwh;
        return delta == 0
            ? "level with system"
            : $"{(delta > 0 ? "+" : "-")}{PlotFormat.Money(Math.Abs(delta))} vs system";
    }

    private string DeltaClass(RegionProfile region) =>
        region.Cost.SlcoeAudPerMwh > _analysis!.Result.Cost.SlcoeAudPerMwh
            ? "delta delta-above"
            : region.Cost.SlcoeAudPerMwh < _analysis.Result.Cost.SlcoeAudPerMwh
                ? "delta delta-below"
                : "delta";

    private static string SizingLabel(StorageSizingOutcome outcome) => outcome switch
    {
        StorageSizingOutcome.NotRequired => "already sufficient",
        StorageSizingOutcome.Resized => "grown to meet target",
        StorageSizingOutcome.EnergyLimited => "energy-limited",
        StorageSizingOutcome.StorageNoLongerImprovesReliability => "no longer improves reliability",
        StorageSizingOutcome.BatteryCapacityLimitReached => "capacity limit reached",
        StorageSizingOutcome.PassLimitReached => "pass limit reached",
        _ => "unknown outcome",
    };

    /// <summary>
    /// Whether transmission was priced in this scope, said as the artifact says it. A regional
    /// result declares transmission not modelled rather than publishing a zero, and the two are
    /// different claims: one is "not in scope", the other is "in scope and free".
    /// </summary>
    /// <param name="withUnit">
    /// False inside the cost table, whose other cells are bare figures under a column that already
    /// states the unit; true where the figure stands alone.
    /// </param>
    private static string TransmissionText(DispatchCostDTO cost, bool withUnit = true) =>
        cost.TransmissionCostStatus == TransmissionCostStatus.Calculated
            ? PlotFormat.MoneyPrecise(cost.TransmissionSlcotAudPerMwh) + (withUnit ? "/MWh" : string.Empty)
            : "not modelled";

    private enum SeriesState
    {
        Loading,
        Loaded,
        Unavailable,
    }

    private sealed record RegionMeasure(
        string Key,
        string Label,
        Func<RegionProfile, double> RegionValue,
        Func<SystemAnalysis, double>? SystemValue,
        Func<double, string> Format,
        string Note,
        string Color);
}
