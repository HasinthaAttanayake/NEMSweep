@page "/dispatch"
@page "/runs/{SweepId}/{PointId}"
@using NEM.Contracts
@using NEM.Web.Services
@using System.Globalization
@inject ArtifactLoader ArtifactLoader
@inject SweepIndexLoader SweepIndexLoader
@inject NavigationManager Navigation

<PageTitle>@PageTitleText</PageTitle>

<main class="dispatch-page">
    <PageHeader Eyebrow="@PageEyebrow" Title="@PageTitleText">
        <ScopeContent>
            @if (_result is not null)
            {
                <ScopeLine Region="@ScopeLabel"
                           Period="@ArtifactPeriod"
                           Resolution="@ResolutionLabel" />
                @if (_systemResult is not null && _systemResult.RegionIds.Length > 0)
                {
                    <MudSelect T="string" Label="View scope" Value="@(_selectedRegionId ?? string.Empty)"
                               ValueChanged="OnRegionChanged" Variant="Variant.Outlined" Class="view-select">
                        <MudSelectItem T="string" Value="@string.Empty">NEM system</MudSelectItem>
                        @foreach (string regionId in _systemResult.RegionIds)
                        {
                            <MudSelectItem T="string" Value="@regionId">@RegionName(regionId)</MudSelectItem>
                        }
                    </MudSelect>
                }
                @if (_runContext is not null)
                {
                    <p class="run-axis">@_runContext.Sweep.Axis.Label: @_runContext.Point.Label (@_runContext.Point.AxisValue.ToString("N0") @_runContext.Sweep.Axis.Unit)</p>
                }
            }
        </ScopeContent>
        <TrailingContent>
            @if (_loadState.Status == ArtifactLoadStatus.Success)
            {
                <div class="dispatch-controls">
                @if (_runContext is not null)
                {
                    <nav class="run-navigation" aria-label="Sweep run navigation">
                        <a href="@SweepPageRoute">All runs in this sweep</a>
                        @if (_runContext.PreviousPoint is not null)
                        {
                            <a href="@RunRoute(_runContext.PreviousPoint)">Previous</a>
                        }
                        @if (_runContext.NextPoint is not null)
                        {
                            <a href="@RunRoute(_runContext.NextPoint)">Next</a>
                        }
                    </nav>
                }
                <MudSelect T="int" Label="View" Value="_selectedView" ValueChanged="OnViewChanged"
                           Variant="Variant.Outlined" Class="view-select">
                    <MudSelectItem T="int" Value="0">Full financial year</MudSelectItem>
                    <MudSelectItem T="int" Value="-1">Single day</MudSelectItem>
                    @foreach (MonthOption month in _months)
                    {
                        <MudSelectItem T="int" Value="month.Month">@month.Label</MudSelectItem>
                    }
                </MudSelect>
                @if (_selectedView == -1)
                {
                    <label class="date-field">
                        <span>Day</span>
                        <input type="date" min="@_minimumDate" max="@_maximumDate"
                               value="@_selectedDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                               @onchange="OnDateChanged" />
                    </label>
                }
                @if (_runContext is not null && ComparablePoints.Count > 0)
                {
                    <MudSelect T="string" Label="Compare with" Value="@(CompareId ?? string.Empty)"
                               ValueChanged="OnComparisonChanged" Variant="Variant.Outlined" Class="view-select">
                        <MudSelectItem T="string" Value="@string.Empty">No comparison</MudSelectItem>
                        @foreach (SweepIndexPointDTO point in ComparablePoints)
                        {
                            <MudSelectItem T="string" Value="@point.PointId">@point.Label</MudSelectItem>
                        }
                    </MudSelect>
                }
                </div>
            }
        </TrailingContent>
    </PageHeader>

    <ArtifactLoadStateView State="_loadState">
        <MetricStrip Items="@DispatchMetrics" AriaLabel="Selected dispatch period summary"
                     Class="dispatch-metrics" />

        @if (_events.Count > 0)
        {
            <nav class="event-jumps" aria-label="Jump to a notable interval">
                <span>Jump to</span>
                @foreach (DispatchEvent notableEvent in _events)
                {
                    <button type="button" @onclick="@(() => JumpTo(notableEvent))">
                        @notableEvent.Label
                        <small>@notableEvent.Instant.ToString("ddd d MMM yyyy")</small>
                    </button>
                }
            </nav>
        }

        @if (_comparisonMessage is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="comparison-alert">@_comparisonMessage</MudAlert>
        }
        else if (_comparison is not null)
        {
            <p class="comparison-note" role="status">
                Dashed traces are <strong>@_comparison.Point.Label</strong>
                (@_comparison.Point.AxisValue.ToString("N0") @_runContext!.Sweep.Axis.Unit),
                drawn on the same axes.
            </p>
        }

        <div class="trace-context">
            <span>@_periodLabel</span>
            <span>@_rawPointCount hourly intervals</span>
            <span>@_displayPointCount displayed averages</span>
            <span>Schema v@_result!.SchemaVersion</span>
        </div>

        <section class="cost-section" aria-labelledby="system-cost-heading">
            <div class="cost-heading">
                <div>
                    <p class="section-label">Full financial year</p>
                    <h2 id="system-cost-heading">System cost</h2>
                    <p>Annualised generation and storage asset costs per MWh served in @ScopeLabel.</p>
                </div>
                <span class="cost-status">@_result.Cost.Status</span>
            </div>

            <div class="cost-layout">
                <div class="cost-primary">
                    <span>System levelised cost</span>
                    <strong>@FormatAudPerMwh(_result.Cost.SlcoeAudPerMwh)</strong>
                    <small>AUD/MWh served</small>
                    <p>Generation and storage assets are included. Transmission is not yet modelled.</p>
                </div>

                <div class="cost-components" aria-label="SLCoE component contributions">
                    <div class="cost-component">
                        <div>
                            <span>Generation</span>
                            <strong>@FormatAudPerMwh(_result.Cost.GenerationSlcoeAudPerMwh) AUD/MWh</strong>
                        </div>
                        <div class="cost-track" aria-hidden="true">
                            <i style="@CostShareStyle(_result.Cost.GenerationSlcoeAudPerMwh)"></i>
                        </div>
                    </div>
                    <div class="cost-component storage-cost-component">
                        <div>
                            <span>Storage assets</span>
                            <strong>@FormatAudPerMwh(_result.Cost.StorageSlcoeAudPerMwh) AUD/MWh</strong>
                        </div>
                        <div class="cost-track" aria-hidden="true">
                            <i style="@CostShareStyle(_result.Cost.StorageSlcoeAudPerMwh)"></i>
                        </div>
                    </div>
                    @if (_result.Cost.TotalAnnualisedCostAud == 0)
                    {
                        <p class="zero-cost-note">The current scenario uses zero-valued economic inputs; the calculation path is active.</p>
                    }
                </div>

                <dl class="cost-ledger">
                    <div><dt>Generation annual cost</dt><dd>@FormatAud(_result.Cost.AnnualisedGenerationCostAud)</dd></div>
                    <div><dt>Storage annual cost</dt><dd>@FormatAud(_result.Cost.AnnualisedStorageCostAud)</dd></div>
                    <div class="cost-total"><dt>Total annual cost</dt><dd>@FormatAud(_result.Cost.TotalAnnualisedCostAud)</dd></div>
                    <div><dt>Electricity served</dt><dd>@AnnualServedEnergyMwh().ToString("N0") MWh</dd></div>
                </dl>
            </div>
        </section>

        <ChartFrame Heading="Generation against demand"
                    Description="Delivered generation is stacked by technology; the demand trace reveals any supply gap."
                    Unit="MW">
            <div class="dispatch-chart">
                <svg viewBox="0 0 1000 440" role="img" aria-label="Stacked generation by technology against operational demand">
                    @for (int tick = 0; tick <= 4; tick++)
                    {
                        double y = ChartY(_chartMaximumMw * tick / 4);
                        <line class="grid-line" x1="64" y1="@y" x2="984" y2="@y" stroke="#dce1e5" stroke-width="1" />
                    }
                    @foreach (AreaLayer area in _areas)
                    {
                        <polygon points="@area.Points" fill="@area.Color"><title>@area.Name</title></polygon>
                    }
                    @if (_comparisonDemandPoints is not null)
                    {
                        <polyline class="demand-line comparison-trace"
                                  points="@_comparisonDemandPoints"
                                  fill="none"
                                  stroke="var(--color-demand-line)"
                                  stroke-width="2"
                                  stroke-dasharray="6 4"
                                  stroke-linejoin="round"
                                  vector-effect="non-scaling-stroke" />
                    }
                    <polyline class="demand-line"
                              points="@_demandPoints"
                              fill="none"
                              stroke="var(--color-demand-line)"
                              stroke-width="2.5"
                              stroke-linejoin="round"
                              vector-effect="non-scaling-stroke" />
                </svg>
                <div class="chart-axis-labels"><span>@_firstLabel</span><span>@_middleLabel</span><span>@_lastLabel</span></div>
            </div>
            <div class="chart-legend" aria-label="Chart series">
                @foreach (AreaLayer area in _areas)
                {
                    <span><i style="background-color: @area.Color"></i>@area.Name</span>
                }
                <span><i class="demand-key"></i>Demand</span>
            </div>
        </ChartFrame>

        <ChartFrame Heading="Storage state of charge"
                    Description="Stored energy at the beginning of each interval for the selected period."
                    Unit="MWh"
                    Class="storage-section">
            @if (_storageTraces.Count == 0)
            {
                <div class="empty-storage" role="status">
                    <MudIcon Icon="@Icons.Material.Filled.BatteryStd" Size="Size.Large" />
                    <div><strong>No storage installed</strong><span>This scenario meets its reliability target without a storage fleet.</span></div>
                </div>
            }
            else
            {
                <div class="dispatch-chart storage-chart">
                    <svg viewBox="0 0 1000 300" role="img" aria-label="Storage state of charge by technology">
                        @for (int tick = 0; tick <= 4; tick++)
                        {
                            double y = StorageChartY(_storageChartMaximumMwh * tick / 4);
                            <line class="grid-line" x1="64" y1="@y" x2="984" y2="@y" stroke="#dce1e5" stroke-width="1" />
                        }
                        @foreach (StorageTrace trace in _comparisonStorageTraces)
                        {
                            <polyline class="comparison-trace" points="@trace.Points" fill="none" stroke="@trace.Color"
                                      stroke-width="2" stroke-dasharray="6 4" stroke-linejoin="round"
                                      vector-effect="non-scaling-stroke">
                                <title>@trace.Technology state of charge, @(_comparison?.Point.Label)</title>
                            </polyline>
                        }
                        @foreach (StorageTrace trace in _storageTraces)
                        {
                            <polyline points="@trace.Points" fill="none" stroke="@trace.Color"
                                      stroke-width="2.5" stroke-linejoin="round" vector-effect="non-scaling-stroke">
                                <title>@trace.Technology state of charge</title>
                            </polyline>
                        }
                    </svg>
                    <div class="chart-axis-labels"><span>@_firstLabel</span><span>@_middleLabel</span><span>@_lastLabel</span></div>
                </div>
                <div class="chart-legend" aria-label="Storage chart series">
                    @foreach (StorageTrace trace in _storageTraces)
                    {
                        <span><i style="background-color: @trace.Color"></i>@trace.Technology · @trace.EnergyCapacityMwh.ToString("N0") MWh / @trace.PowerCapacityMw.ToString("N0") MW</span>
                    }
                </div>
            }
        </ChartFrame>

        <ChartFrame Heading="Unserved demand and curtailment"
                    Description="Demand the fleet could not meet, and available generation it could not use, over the selected period."
                    Unit="MW"
                    Class="headroom-section">
            <div class="dispatch-chart headroom-chart">
                <svg viewBox="0 0 1000 300" role="img" aria-label="Unserved demand and curtailment">
                    @for (int tick = 0; tick <= 4; tick++)
                    {
                        double y = HeadroomChartY(_headroomChartMaximumMw * tick / 4);
                        <line class="grid-line" x1="64" y1="@y" x2="984" y2="@y"
                              stroke="var(--color-border)" stroke-width="1" />
                    }
                    @foreach (HeadroomTrace trace in _comparisonHeadroomTraces)
                    {
                        <polyline class="comparison-trace" points="@trace.Points" fill="none" stroke="@trace.Color"
                                  stroke-width="2" stroke-dasharray="6 4" vector-effect="non-scaling-stroke">
                            <title>@trace.Name, @(_comparison?.Point.Label)</title>
                        </polyline>
                    }
                    @foreach (HeadroomTrace trace in _headroomTraces)
                    {
                        <polyline points="@trace.Points" fill="none" stroke="@trace.Color"
                                  stroke-width="2.5" vector-effect="non-scaling-stroke">
                            <title>@trace.Name</title>
                        </polyline>
                    }
                </svg>
                <div class="chart-axis-labels"><span>@_firstLabel</span><span>@_middleLabel</span><span>@_lastLabel</span></div>
            </div>
            <div class="chart-legend" aria-label="Headroom chart series">
                @foreach (HeadroomTrace trace in _headroomTraces)
                {
                    <span><i style="background-color: @trace.Color"></i>@trace.Name</span>
                }
                <span class="headroom-peak">Peak in view: @_peakUnservedPowerMw.ToString("N0") MW unserved, @_peakCurtailmentMw.ToString("N0") MW curtailed</span>
            </div>
        </ChartFrame>

        <section class="reliability-band" aria-label="Reliability and storage sizing">
            <div>
                <span>Reliability</span>
                <strong class="@(_result.Reliability.WithinTarget ? "within-target" : "outside-target")">
                    @(_result.Reliability.WithinTarget ? "Within target" : "Outside target")
                </strong>
                <small>
                    @FormatUsePercentage(_result.Reliability.AchievedUsePercentageOfDemand) unserved
                    against a @FormatUsePercentage(_result.Reliability.TargetUsePercentageOfDemand) target@(ReliabilityStandardSuffix)
                </small>
            </div>
            <div>
                <span>Storage sizing</span>
                <strong>@SizingLabel(_result.StorageSizing)</strong>
                @if (_result.StorageSizing.EnergyLimitedEvidence is { } evidence)
                {
                    <small>
                        @evidence.ShortfallEnergyGwh.ToString("N3") GWh system generation shortfall
                        · @evidence.BindingIntervalIndices.Length binding @(
                            evidence.BindingIntervalIndices.Length == 1 ? "hour" : "hours")
                    </small>
                }
                else
                {
                    <small>
                        @_result.StorageSizing.InitialEnergyMwh.ToString("N0") MWh /
                        @_result.StorageSizing.InitialPowerMw.ToString("N0") MW →
                        @_result.StorageSizing.FinalEnergyMwh.ToString("N0") MWh /
                        @_result.StorageSizing.FinalPowerMw.ToString("N0") MW
                        · ceiling @_result.StorageSizing.MaximumEnergyMwh.ToString("N0") MWh
                        · @_result.StorageSizing.PassesUsed dispatch @(_result.StorageSizing.PassesUsed == 1 ? "pass" : "passes")
                    </small>
                }
            </div>
        </section>

        <WeatherBasisNote Basis="_result.DataSources.WeatherBasis" />

        <section class="assumption-band" aria-label="Scenario assumptions and provenance">
            <div><span>Scenario fleet</span><strong>@string.Join(" · ", _result!.PowerSystem.Fleets.Select(fleet => $"{fleet.Technology} {fleet.NameplateCapacityMw:N0} MW"))</strong></div>
            <div><span>Storage fleet</span><strong>@StorageFleetSummary()</strong></div>
            <div>
                <span>Reliability outcome</span>
                <strong>@_result.Metrics.HoursServedFraction.ToString("P3") hours served</strong>
                <small>@_result.Metrics.UnservedHours unserved hours · @_result.Metrics.UnservedEnergyMwh.ToString("N0") MWh USE</small>
            </div>
        </section>
        <ProvenanceFooter
                          CommitSha="@SweepCommitSha"
                          CommitUrl="@SweepCommitUrl"
                          IsDirty="@SweepWorkingTreeDirty"
                          Inputs="@ProvenanceInputs"
                          Region="@ScopeLabel"
                          Period="@ArtifactPeriod"
                          Resolution="@ResolutionLabel" />
        @if (_runContext is not null)
        {
            <p class="run-config-link"><a href="@_runContext.ConfigRepositoryUrl">View emitted run config</a></p>
        }
    </ArtifactLoadStateView>
</main>

@code {
    private const double ChartLeft = 64;
    private const double ChartRight = 984;
    private const double ChartTop = 12;
    private const double ChartBottom = 408;
    private const double StorageChartTop = 12;
    private const double StorageChartBottom = 276;
    private static readonly string[] PreferredTechnologyOrder = ["Solar", "Wind", "Hydro", "Coal", "Gas"];
    private static readonly Dictionary<string, string> TechnologyColors = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Solar"] = "#e8b84a",
        ["Wind"] = "#5aa8a1",
        ["Hydro"] = "#4f7db8",
        ["Coal"] = "#59636e",
        ["Gas"] = "#c76d4d",
    };
    private static readonly Dictionary<string, string> StorageColors = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Battery"] = "#176b5b",
        ["PumpedHydro"] = "#4f7db8",
    };

    private static readonly string[] HeadroomColors = ["#b3341f", "#7a6bbd"];

    private ArtifactLoadState _loadState = ArtifactLoadState.Loading();
    private DispatchResultsDTO? _result;
    private SystemDispatchResultsDTO? _systemResult;
    private string? _selectedRegionId;
    private string? _selectedRegionDetailPath;
    private DispatchRunContext? _runContext;
    private DispatchComparison? _comparison;
    private string? _comparisonMessage;
    private IReadOnlyList<DispatchEvent> _events = [];
    private List<AreaLayer> _areas = [];
    private List<StorageTrace> _storageTraces = [];
    private List<StorageTrace> _comparisonStorageTraces = [];
    private List<HeadroomTrace> _headroomTraces = [];
    private List<HeadroomTrace> _comparisonHeadroomTraces = [];
    private string? _comparisonDemandPoints;
    private double _headroomChartMaximumMw = 1;
    private double _peakCurtailmentMw;
    private string _demandPoints = string.Empty;
    private string _firstLabel = string.Empty;
    private string _middleLabel = string.Empty;
    private string _lastLabel = string.Empty;
    private string _periodLabel = string.Empty;
    private string _minimumDate = string.Empty;
    private string _maximumDate = string.Empty;
    private double _chartMaximumMw = 1;
    private double _storageChartMaximumMwh = 1;
    private double _peakDemandMw;
    private double _deliveredEnergyMwh;
    private double _renewableSharePercent;
    private double _unservedEnergyMwh;
    private double _unservedEnergyPercent;
    private double _peakUnservedPowerMw;
    private int _rawPointCount;
    private int _displayPointCount;
    private int _selectedView;
    private DateTime _selectedDate;
    private List<MonthOption> _months = [];

    [Parameter] public string? SweepId { get; set; }
    [Parameter] public string? PointId { get; set; }

    [SupplyParameterFromQuery(Name = "compare")]
    public string? CompareId { get; set; }

    [SupplyParameterFromQuery(Name = "region")]
    public string? RegionQuery { get; set; }

    /// <summary>Every other point in the sweep that has a detail artifact to draw.</summary>
    private IReadOnlyList<SweepIndexPointDTO> ComparablePoints => _runContext is null
        ? []
        : _runContext.Sweep.Points
            .Where(point => point.Status == SweepPointStatus.Succeeded
                && !string.IsNullOrWhiteSpace(point.DetailPath)
                && point.PointId != _runContext.Point.PointId)
            .ToArray();

    private bool IsRunRoute => !string.IsNullOrWhiteSpace(SweepId) || !string.IsNullOrWhiteSpace(PointId);
    private string SweepPageRoute => string.IsNullOrWhiteSpace(RegionQuery)
        ? SweepPaths.PageRoute(_runContext!.Sweep.SweepId)
        : $"{SweepPaths.PageRoute(_runContext!.Sweep.SweepId)}?region={Uri.EscapeDataString(RegionQuery)}";
    private string PageTitleText => _runContext is null ? "Dispatch" : _runContext.Sweep.Name;
    private string PageEyebrow => _runContext is null ? "Merit-order simulation" : "Sweep run";

    private string? SweepCommitSha => _runContext?.Sweep.Provenance.GitCommitSha;
    private string? SweepCommitUrl => SweepCommitSha is null
        ? null
        : $"https://github.com/HasinthaAttanayake/NemSim/commit/{SweepCommitSha}";
    private bool? SweepWorkingTreeDirty => _runContext?.Sweep.Provenance.WorkingTreeDirty;

    private IReadOnlyList<MetricStripItem> DispatchMetrics =>
    [
        new("Peak demand", _peakDemandMw.ToString("N0"), "MW"),
        new("Energy delivered", _deliveredEnergyMwh.ToString("N0"), "MWh"),
        new("Renewable share", _renewableSharePercent.ToString("N1"), "% of delivered generation"),
        new("Unserved energy", _unservedEnergyMwh.ToString("N0"), $"MWh · {_unservedEnergyPercent:N3}% USE · {_peakUnservedPowerMw:N0} MW peak"),
    ];

    private IReadOnlyList<ProvenanceInputFile> ProvenanceInputs => _runContext is null
        ?
        [
            new(_result!.DataSources.DemandInput.FileName, _result.DataSources.DemandInput.Sha256),
            new(_result.DataSources.WeatherInput.FileName, _result.DataSources.WeatherInput.Sha256),
        ]
        : _runContext.Sweep.Provenance.InputFiles
            .Select(input => new ProvenanceInputFile(input.Path, input.Sha256, input.Purpose))
            .ToArray();

    private string ReliabilityStandardSuffix => _result!.Reliability.StandardName is { Length: > 0 } name
        ? $" ({name})"
        : string.Empty;

    /// <summary>Unserved-energy figures are small fractions of a percent; fixed decimals round them away.</summary>
    private static string SizingLabel(StorageSizingOutcomeDTO sizing) => sizing.Outcome switch
    {
        StorageSizingOutcome.NotRequired => "Not required",
        StorageSizingOutcome.Resized => "Resized",
        StorageSizingOutcome.EnergyLimited => "Energy-limited",
        StorageSizingOutcome.StorageNoLongerImprovesReliability =>
            "Storage no longer improves reliability",
        StorageSizingOutcome.BatteryCapacityLimitReached => "Battery capacity limit reached",
        StorageSizingOutcome.PassLimitReached => "Pass limit reached",
        _ => "Unknown",
    };

    private static string FormatUsePercentage(double value) => value == 0
        ? "0%"
        : $"{value.ToString(value >= 0.01 ? "N2" : "G3", CultureInfo.CurrentCulture)}%";

    private string ScopeLabel => _selectedRegionId is null ? "NEM system" : RegionName(_selectedRegionId);
    private string ArtifactPeriod => $"{_result!.Scenario.PeriodStart:dd MMM yyyy} to {_result.Scenario.PeriodEnd.AddTicks(-1):dd MMM yyyy}";
    private string ResolutionLabel => $"{_result!.Scenario.Resolution.TotalHours:N0}-hour intervals";

    protected override async Task OnParametersSetAsync()
    {
        _loadState = ArtifactLoadState.Loading();
        _result = null;
        _systemResult = null;
        _selectedRegionId = null;
        _selectedRegionDetailPath = null;
        _runContext = null;
        _comparison = null;
        _comparisonMessage = null;
        _events = [];

        try
        {
            if (IsRunRoute)
            {
                await LoadRunAsync();
                return;
            }

            ArtifactLoadResult<SystemDispatchResultsDTO> loadResult = await ArtifactLoader.LoadAsync<SystemDispatchResultsDTO>("data/results.json");
            if (!loadResult.IsSuccess)
            {
                _loadState = loadResult.State;
                return;
            }

            _systemResult = loadResult.Value!;
            await InitialiseResultAsync(ToEvidence(_systemResult), null, loadResult.State);
        }
        catch (Exception exception)
        {
            _loadState = ArtifactLoadState.Failed($"Error loading dispatch results: {exception.Message}");
        }
    }

    private async Task LoadRunAsync()
    {
        string indexPath = $"data/sweeps/{Uri.EscapeDataString(SweepId!)}/index.json";
        ArtifactLoadResult<SweepIndexDTO> indexResult = await SweepIndexLoader.LoadAsync(indexPath);
        if (!indexResult.IsSuccess)
        {
            _loadState = indexResult.State.Status == ArtifactLoadStatus.NotFound
                ? ArtifactLoadState.NotFound("Sweep was not found.")
                : indexResult.State;
            return;
        }

        DispatchRunContext? context = DispatchRunContextResolver.Resolve(indexResult.Value!, SweepId, PointId);
        if (context is null)
        {
            // A run that reached a constraint is a result, not a missing page: it is in the index
            // and has no detail to show, so the page says which constraint rather than "not found".
            SweepIndexPointDTO? constrained = indexResult.Value!.Points.FirstOrDefault(point =>
                string.Equals(point.PointId, PointId, StringComparison.Ordinal)
                && point.Status == SweepPointStatus.Failed);
            _loadState = constrained?.Failure is { } failure
                ? ArtifactLoadState.Empty(
                    $"This run reached a constraint at the {failure.Stage.ToString().ToLowerInvariant()} "
                    + $"stage and produced no results to view. {failure.Message}")
                : ArtifactLoadState.NotFound("Sweep point was not found.");
            return;
        }

        ArtifactLoadResult<SystemDispatchResultsDTO> detailResult = await ArtifactLoader.LoadAsync<SystemDispatchResultsDTO>(context.DetailArtifactPath);
        if (!detailResult.IsSuccess)
        {
            _loadState = detailResult.State.Status == ArtifactLoadStatus.NotFound
                ? ArtifactLoadState.NotFound("Sweep point detail was not found.")
                : detailResult.State;
            return;
        }

        _systemResult = detailResult.Value!;
        await InitialiseResultAsync(ToEvidence(_systemResult), context, detailResult.State);
        if (_loadState.Status == ArtifactLoadStatus.Success)
        {
            if (!string.IsNullOrWhiteSpace(RegionQuery)
                && RegionDetailPath(context.Point, RegionQuery) is not null)
            {
                await OnRegionChanged(RegionQuery);
            }

            await LoadComparisonAsync(context);
        }
    }

    /// <summary>
    /// Loads the second run named by the compare query parameter. A comparison that cannot be
    /// loaded or cannot share axes leaves the primary run intact and says why.
    /// </summary>
    private async Task LoadComparisonAsync(DispatchRunContext context)
    {
        if (string.IsNullOrWhiteSpace(CompareId))
        {
            return;
        }

        DispatchRunContext? comparisonContext = DispatchRunContextResolver.Resolve(
            context.Sweep,
            context.Sweep.SweepId,
            CompareId);
        if (comparisonContext is null)
        {
            _comparisonMessage = "The run selected for comparison is not part of this sweep.";
            return;
        }

        ArtifactLoadResult<SystemDispatchResultsDTO> detail =
            await ArtifactLoader.LoadAsync<SystemDispatchResultsDTO>(comparisonContext.DetailArtifactPath);
        if (!detail.IsSuccess)
        {
            _comparisonMessage = "The run selected for comparison could not be loaded.";
            return;
        }

        DispatchResultsDTO? comparison = await LoadSelectedEvidenceAsync(
            detail.Value!,
            comparisonContext,
            _selectedRegionId,
            RegionDetailPath(comparisonContext.Point, _selectedRegionId));
        if (comparison is null)
        {
            _comparisonMessage = "The run selected for comparison is missing its base demand series.";
            return;
        }

        _comparisonMessage = DispatchComparisonValidator.Validate(_result!, comparison);
        if (_comparisonMessage is null)
        {
            _comparison = new DispatchComparison(comparisonContext.Point, comparison);
            BuildChart();
        }
    }

    private void OnComparisonChanged(string pointId) => Navigation.NavigateTo(
        string.IsNullOrEmpty(pointId)
            ? RunPath(_runContext!.Point)
            : AddQuery(RunPath(_runContext!.Point), "compare", pointId));

    private async Task InitialiseResultAsync(
        DispatchResultsDTO result,
        DispatchRunContext? context,
        ArtifactLoadState successState,
        string? artifactPath = null)
    {
        if (context is not null)
        {
            DispatchResultsDTO? resolved = await ResolveBaseDemandAsync(result, context, artifactPath);
            if (resolved is null)
            {
                _loadState = ArtifactLoadState.InvalidData("Sweep point base demand series is missing or does not match the dispatch period.");
                return;
            }

            result = resolved;
        }

        _result = result;
        _runContext = context;
        DispatchSeriesDTO? series = _result.DataSeries;
        DispatchPowerSystemDTO? powerSystem = _result.PowerSystem;
            if (series is null
                || powerSystem is null
                || series.Demand is null
                || series.Demand.BaseDemandMw is null
                || series.Demand.AdditiveComponentsByNameMw is null
                || series.Demand.TotalDemandMw is null
                || series.CurtailmentMw is null
                || series.UnservedDemandMw is null
                || series.ChargeMw is null
                || series.DischargeMw is null
                || series.StateOfChargeByTechnologyMwh is null
                || series.DeliveredGenerationByTechnologyMw is null
                || powerSystem.StorageFleets is null)
            {
                _loadState = ArtifactLoadState.InvalidData("Dispatch result series are empty or misaligned.");
                return;
            }

            int length = series.Demand.TotalDemandMw.Length;
            if (length == 0
                || _result.Scenario.Resolution <= TimeSpan.Zero
                || series.Demand.BaseDemandMw.Length != length
                || series.Demand.AdditiveComponentsByNameMw.Any(component =>
                    string.IsNullOrWhiteSpace(component.Key)
                    || component.Value is null
                    || component.Value.Length != length)
                || series.CurtailmentMw.Length != length
                || series.UnservedDemandMw.Length != length
                || series.ChargeMw.Length != length
                || series.DischargeMw.Length != length
                || series.StateOfChargeByTechnologyMwh.Values.Any(values =>
                    values is null || values.Length != length)
                || powerSystem.StorageFleets.Any(fleet =>
                    fleet.EnergyCapacityMwh <= 0
                    || fleet.PowerCapacityMw <= 0
                    || !series.StateOfChargeByTechnologyMwh.ContainsKey(fleet.Technology))
                || series.DeliveredGenerationByTechnologyMw.Values.Any(values =>
                    values is null || values.Length != length))
            {
                _loadState = ArtifactLoadState.InvalidData("Dispatch result series are empty or misaligned.");
                return;
            }

            for (int index = 0; index < length; index++)
            {
                if (!DispatchDemandDecompositionValidator.IsWithinRoundingEnvelope(
                    series.Demand.BaseDemandMw[index],
                    series.Demand.AdditiveComponentsByNameMw.Values.Select(component => component[index]),
                    series.Demand.TotalDemandMw[index]))
                {
                    _loadState = ArtifactLoadState.InvalidData("Dispatch demand decomposition does not add up.");
                    return;
                }
            }

            _selectedDate = _result.Scenario.PeriodStart.Date;
            _minimumDate = _result.Scenario.PeriodStart.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
            _maximumDate = _result.Scenario.PeriodEnd.AddTicks(-1).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
            _months = BuildMonthOptions(_result.Scenario.PeriodStart, _result.Scenario.PeriodEnd);
            _events = DispatchEventLocator.Locate(_result);
            BuildChart();
        _loadState = successState;
    }

    /// <summary>
    /// Points in a sweep share one base demand series file, so it is resolved once and reused when
    /// a second run is drawn over the first. Returns null when the series is absent or misaligned.
    /// </summary>
    private async Task<DispatchResultsDTO?> ResolveBaseDemandAsync(
        DispatchResultsDTO result,
        DispatchRunContext? context,
        string? artifactPath = null)
    {
        if (result.DataSeries.Demand.BaseDemandMw is not null)
        {
            return result;
        }

        string? seriesPath = context is not null
            ? context.ResolveReferencedArtifactPath(result.DataSeries.Demand.BaseDemandSeriesPath, artifactPath)
            : ResolveDataArtifactPath(result.DataSeries.Demand.BaseDemandSeriesPath, artifactPath);
        if (seriesPath is null)
        {
            return null;
        }

        if (!_baseDemandCache.TryGetValue(seriesPath, out RegularSeriesDTO? baseDemand))
        {
            ArtifactLoadResult<RegularSeriesDTO> seriesResult =
                await ArtifactLoader.LoadAsync<RegularSeriesDTO>(seriesPath);
            if (!seriesResult.IsSuccess)
            {
                return null;
            }

            baseDemand = seriesResult.Value!;
            _baseDemandCache[seriesPath] = baseDemand;
        }

        if (baseDemand!.Start != result.Scenario.PeriodStart
            || baseDemand.Resolution != result.Scenario.Resolution)
        {
            return null;
        }

        return result with
        {
            DataSeries = result.DataSeries with
            {
                Demand = result.DataSeries.Demand with { BaseDemandMw = baseDemand.ValuesMw },
            },
        };
    }

    private static string? ResolveDataArtifactPath(string? reference, string? originPath)
    {
        if (string.IsNullOrWhiteSpace(reference) || string.IsNullOrWhiteSpace(originPath))
        {
            return null;
        }

        Uri origin = new("https://artifact.invalid/");
        Uri sourceUri = new(origin, originPath);
        if (!Uri.TryCreate(sourceUri, reference, out Uri? referenceUri)
            || !referenceUri.Host.Equals(origin.Host, StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }

        string path = referenceUri.AbsolutePath.TrimStart('/');
        return path.StartsWith("data/", StringComparison.Ordinal) ? path : null;
    }

    private async Task OnRegionChanged(string regionId)
    {
        string? selectedRegionId = string.IsNullOrEmpty(regionId) ? null : regionId;
        if (_systemResult is null || string.Equals(_selectedRegionId, selectedRegionId, StringComparison.Ordinal))
        {
            return;
        }

        _selectedRegionId = selectedRegionId;
        _selectedRegionDetailPath = selectedRegionId is null
            ? null
            : _runContext is null
                ? _systemResult.RegionSummariesById.GetValueOrDefault(selectedRegionId)?.DetailPath
                : RegionDetailPath(_runContext.Point, selectedRegionId);
        if (selectedRegionId is null)
        {
            await InitialiseResultAsync(ToEvidence(_systemResult), _runContext, new(ArtifactLoadStatus.Success, null));
            return;
        }

        if (string.IsNullOrWhiteSpace(_selectedRegionDetailPath))
        {
            _loadState = ArtifactLoadState.InvalidData($"Regional detail for {selectedRegionId} is missing.");
            return;
        }

        string systemPath = _runContext?.DetailArtifactPath ?? "data/results.json";
        string regionPath = _runContext is null
            ? $"data/{_selectedRegionDetailPath}"
            : $"{_runContext.SweepRootPath}/{_selectedRegionDetailPath}";
        ArtifactLoadResult<SystemRegionArtifactPair> pair = await ArtifactLoader.LoadSystemWithRegionAsync(systemPath, regionPath);
        if (!pair.IsSuccess)
        {
            _loadState = pair.State;
            return;
        }

        await InitialiseResultAsync(
            ToEvidence(pair.Value!.Region),
            _runContext,
            pair.State,
            regionPath);
    }

    private async Task<DispatchResultsDTO?> LoadSelectedEvidenceAsync(
        SystemDispatchResultsDTO system,
        DispatchRunContext context,
        string? regionId,
        string? regionDetailPath)
    {
        if (regionId is null)
        {
            return ToEvidence(system);
        }

        if (string.IsNullOrWhiteSpace(regionDetailPath))
        {
            return null;
        }

        ArtifactLoadResult<SystemRegionArtifactPair> pair = await ArtifactLoader.LoadSystemWithRegionAsync(
            context.DetailArtifactPath,
            $"{context.SweepRootPath}/{regionDetailPath}");
        if (!pair.IsSuccess)
        {
            return null;
        }

        DispatchResultsDTO regional = ToEvidence(pair.Value!.Region);
        return await ResolveBaseDemandAsync(
            regional,
            context,
            $"{context.SweepRootPath}/{regionDetailPath}");
    }

    private string? RegionDetailPath(SweepIndexPointDTO point, string? regionId) => regionId is null
        ? null
        : point.RegionDetails?.FirstOrDefault(detail =>
            string.Equals(detail.RegionId, regionId, StringComparison.OrdinalIgnoreCase))?.DetailPath;

    private static DispatchResultsDTO ToEvidence(SystemDispatchResultsDTO result)
    {
        DispatchSourcesDTO sources = result.DataSourcesByRegion.Values.FirstOrDefault()
            ?? throw new InvalidOperationException("System dispatch has no regional data sources.");
        return new(
            result.SchemaVersion,
            new("system", "NEM system", "NEM", result.PeriodStart, result.PeriodEnd, result.Resolution),
            DateTimeOffset.MinValue,
            sources,
            new("system", [], []),
            result.DataSeries,
            result.Metrics,
            result.Reliability,
            result.StorageSizing,
            result.Cost);
    }

    private static DispatchResultsDTO ToEvidence(RegionDispatchResultsDTO result) => new(
        result.SchemaVersion,
        new(result.RegionId, RegionName(result.RegionId), result.RegionId, result.PeriodStart, result.PeriodEnd, result.Resolution),
        DateTimeOffset.MinValue,
        result.DataSources,
        result.PowerSystem,
        result.DataSeries,
        result.Metrics,
        result.Reliability,
        result.StorageSizing,
        result.Cost);

    private void JumpTo(DispatchEvent notableEvent)
    {
        _selectedView = -1;
        _selectedDate = notableEvent.Instant.Date;
        BuildChart();
    }

    private string RunPath(SweepIndexPointDTO point) =>
        SweepPaths.RunRoute(_runContext!.Sweep.SweepId, point.PointId, RegionQuery);

    /// <summary>
    /// Stepping along the sweep keeps whatever the reader is comparing against, so the comparison
    /// survives Previous and Next rather than having to be reselected at every point.
    /// </summary>
    private string RunRoute(SweepIndexPointDTO point) => string.IsNullOrWhiteSpace(CompareId) || CompareId == point.PointId
        ? RunPath(point)
        : AddQuery(RunPath(point), "compare", CompareId);

    private static string AddQuery(string path, string name, string value) =>
        $"{path}{(path.Contains('?') ? '&' : '?')}{name}={Uri.EscapeDataString(value)}";

    private void OnViewChanged(int view)
    {
        _selectedView = view;
        BuildChart();
    }

    private void OnDateChanged(ChangeEventArgs args)
    {
        if (DateTime.TryParseExact(args.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture,
            DateTimeStyles.None, out DateTime selectedDate))
        {
            _selectedDate = selectedDate;
            BuildChart();
        }
    }

    private void BuildChart()
    {
        DispatchResultsDTO result = _result!;
        double[] totalDemandMw = result.DataSeries.Demand.TotalDemandMw;
        int[] selectedIndexes = Enumerable.Range(0, totalDemandMw.Length)
            .Where(IsSelected).ToArray();
        _rawPointCount = selectedIndexes.Length;
        _peakDemandMw = selectedIndexes.Max(index => totalDemandMw[index]);
        _unservedEnergyMwh = selectedIndexes.Sum(index => result.DataSeries.UnservedDemandMw[index])
            * result.Scenario.Resolution.TotalHours;
        double demandEnergyMwh = selectedIndexes.Sum(index => totalDemandMw[index])
            * result.Scenario.Resolution.TotalHours;
        _unservedEnergyPercent = demandEnergyMwh == 0
            ? 0
            : 100.0 * _unservedEnergyMwh / demandEnergyMwh;
        _peakUnservedPowerMw = selectedIndexes.Max(index => result.DataSeries.UnservedDemandMw[index]);

        string[] technologies = PreferredTechnologyOrder
            .Where(result.DataSeries.DeliveredGenerationByTechnologyMw.ContainsKey)
            .Concat(result.DataSeries.DeliveredGenerationByTechnologyMw.Keys.Except(PreferredTechnologyOrder))
            .ToArray();
        _deliveredEnergyMwh = technologies.Sum(technology => selectedIndexes.Sum(
            index => result.DataSeries.DeliveredGenerationByTechnologyMw[technology][index]))
            * result.Scenario.Resolution.TotalHours;
        double renewableEnergyMwh = technologies
            .Where(technology => technology is "Solar" or "Wind")
            .Sum(technology => selectedIndexes.Sum(
                index => result.DataSeries.DeliveredGenerationByTechnologyMw[technology][index]))
            * result.Scenario.Resolution.TotalHours;
        _renewableSharePercent = _deliveredEnergyMwh == 0 ? 0 : 100 * renewableEnergyMwh / _deliveredEnergyMwh;

        int targetPoints = _selectedView == -1 ? selectedIndexes.Length : 480;
        int bucketSize = Math.Max(1, (int)Math.Ceiling((double)selectedIndexes.Length / targetPoints));
        var timestamps = new List<DateTimeOffset>();
        var demand = new List<double>();
        var generation = technologies.ToDictionary(technology => technology, _ => new List<double>());
        for (int offset = 0; offset < selectedIndexes.Length; offset += bucketSize)
        {
            int[] bucket = selectedIndexes[offset..Math.Min(offset + bucketSize, selectedIndexes.Length)];
            timestamps.Add(InstantAt(bucket[0]));
            demand.Add(bucket.Average(index => totalDemandMw[index]));
            foreach (string technology in technologies)
            {
                generation[technology].Add(bucket.Average(
                    index => result.DataSeries.DeliveredGenerationByTechnologyMw[technology][index]));
            }
        }

        _displayPointCount = demand.Count;
        double[] cumulative = new double[demand.Count];
        _chartMaximumMw = Math.Max(demand.Max(), Enumerable.Range(0, demand.Count)
            .Max(index => technologies.Sum(technology => generation[technology][index])));
        _chartMaximumMw = Math.Ceiling(_chartMaximumMw / 1000) * 1000;
        _areas = [];
        foreach (string technology in technologies)
        {
            double[] baseline = cumulative.ToArray();
            for (int index = 0; index < cumulative.Length; index++)
            {
                cumulative[index] += generation[technology][index];
            }
            _areas.Add(new AreaLayer(
                technology,
                TechnologyColors.GetValueOrDefault(technology, "#8a7d72"),
                AreaPoints(baseline, cumulative)));
        }
        _demandPoints = LinePoints(demand);
        _peakCurtailmentMw = selectedIndexes.Max(index => result.DataSeries.CurtailmentMw[index]);
        BuildStorageChart(result, selectedIndexes, bucketSize);
        BuildHeadroomChart(result, selectedIndexes, bucketSize);
        BuildComparisonTraces(selectedIndexes, bucketSize);

        DateTimeOffset selectedStart = InstantAt(selectedIndexes[0]);
        DateTimeOffset selectedEnd = InstantAt(selectedIndexes[^1]) + result.Scenario.Resolution;
        _periodLabel = _selectedView == -1
            ? selectedStart.ToString("dddd, dd MMMM yyyy")
            : $"{selectedStart:dd MMM yyyy} to {selectedEnd.AddTicks(-1):dd MMM yyyy}";
        string labelFormat = _selectedView == -1 ? "HH:mm" : _selectedView == 0 ? "MMM yyyy" : "dd MMM";
        _firstLabel = timestamps[0].ToString(labelFormat);
        _middleLabel = timestamps[timestamps.Count / 2].ToString(labelFormat);
        _lastLabel = timestamps[^1].ToString(labelFormat);
    }

    /// <summary>
    /// Unserved demand and curtailment share one axis because they are the two ways the fleet and
    /// the load fail to meet: both are peaks within the bucket, never averages, so a three-hour
    /// event in a year view is still visible.
    /// </summary>
    private void BuildHeadroomChart(
        DispatchResultsDTO result,
        int[] selectedIndexes,
        int bucketSize)
    {
        List<double> unserved = BucketPeaks(result.DataSeries.UnservedDemandMw, selectedIndexes, bucketSize);
        List<double> curtailment = BucketPeaks(result.DataSeries.CurtailmentMw, selectedIndexes, bucketSize);
        _headroomChartMaximumMw = Math.Max(1, Math.Max(
            unserved.DefaultIfEmpty(0).Max(),
            curtailment.DefaultIfEmpty(0).Max()));
        _headroomTraces =
        [
            new HeadroomTrace("Unserved demand", HeadroomColors[0], HeadroomLinePoints(unserved)),
            new HeadroomTrace("Curtailment", HeadroomColors[1], HeadroomLinePoints(curtailment)),
        ];
    }

    private void BuildComparisonTraces(int[] selectedIndexes, int bucketSize)
    {
        _comparisonDemandPoints = null;
        _comparisonStorageTraces = [];
        _comparisonHeadroomTraces = [];
        if (_comparison is null)
        {
            return;
        }

        DispatchResultsDTO comparison = _comparison.Result;
        List<double> demand = BucketAverages(comparison.DataSeries.Demand.TotalDemandMw, selectedIndexes, bucketSize);
        _comparisonDemandPoints = LinePoints(demand);

        foreach (DispatchStorageFleetDTO fleet in comparison.PowerSystem.StorageFleets)
        {
            if (!comparison.DataSeries.StateOfChargeByTechnologyMwh.TryGetValue(fleet.Technology, out double[]? stateOfCharge))
            {
                continue;
            }

            _comparisonStorageTraces.Add(new StorageTrace(
                fleet.Technology,
                StorageColors.GetValueOrDefault(fleet.Technology, "#8a7d72"),
                fleet.EnergyCapacityMwh,
                fleet.PowerCapacityMw,
                [],
                StorageLinePoints(BucketFirsts(stateOfCharge, selectedIndexes, bucketSize))));
        }

        _comparisonHeadroomTraces =
        [
            new HeadroomTrace(
                "Unserved demand",
                HeadroomColors[0],
                HeadroomLinePoints(BucketPeaks(comparison.DataSeries.UnservedDemandMw, selectedIndexes, bucketSize))),
            new HeadroomTrace(
                "Curtailment",
                HeadroomColors[1],
                HeadroomLinePoints(BucketPeaks(comparison.DataSeries.CurtailmentMw, selectedIndexes, bucketSize))),
        ];
    }

    private static List<double> BucketPeaks(double[] series, int[] selectedIndexes, int bucketSize) =>
        Bucket(selectedIndexes, bucketSize, bucket => bucket.Max(index => series[index]));

    private static List<double> BucketAverages(double[] series, int[] selectedIndexes, int bucketSize) =>
        Bucket(selectedIndexes, bucketSize, bucket => bucket.Average(index => series[index]));

    private static List<double> BucketFirsts(double[] series, int[] selectedIndexes, int bucketSize) =>
        Bucket(selectedIndexes, bucketSize, bucket => series[bucket[0]]);

    private static List<double> Bucket(int[] selectedIndexes, int bucketSize, Func<int[], double> reduce)
    {
        var values = new List<double>();
        for (int offset = 0; offset < selectedIndexes.Length; offset += bucketSize)
        {
            values.Add(reduce(selectedIndexes[offset..Math.Min(offset + bucketSize, selectedIndexes.Length)]));
        }

        return values;
    }

    private void BuildStorageChart(
        DispatchResultsDTO result,
        int[] selectedIndexes,
        int bucketSize)
    {
        _storageTraces = [];
        foreach (DispatchStorageFleetDTO fleet in result.PowerSystem.StorageFleets)
        {
            double[] stateOfCharge = result.DataSeries.StateOfChargeByTechnologyMwh[fleet.Technology];
            var displayedValues = new List<double>();
            for (int offset = 0; offset < selectedIndexes.Length; offset += bucketSize)
            {
                int[] bucket = selectedIndexes[offset..Math.Min(offset + bucketSize, selectedIndexes.Length)];
                displayedValues.Add(stateOfCharge[bucket[0]]);
            }

            _storageTraces.Add(new StorageTrace(
                fleet.Technology,
                StorageColors.GetValueOrDefault(fleet.Technology, "#8a7d72"),
                fleet.EnergyCapacityMwh,
                fleet.PowerCapacityMw,
                displayedValues));
        }

        _storageChartMaximumMwh = Math.Max(
            1,
            result.PowerSystem.StorageFleets
                .Select(fleet => fleet.EnergyCapacityMwh)
                .DefaultIfEmpty(1)
                .Max());
        _storageTraces = _storageTraces.Select(trace => trace with
        {
            Points = StorageLinePoints(trace.Values),
        }).ToList();
    }

    private string AreaPoints(double[] baseline, double[] top) => string.Join(" ",
        top.Select((value, index) => Point(index, value, top.Length))
            .Concat(baseline.Select((value, index) => Point(index, value, baseline.Length)).Reverse()));

    private string LinePoints(IReadOnlyList<double> values) => string.Join(" ",
        values.Select((value, index) => Point(index, value, values.Count)));

    private string StorageLinePoints(IReadOnlyList<double> values) => string.Join(" ",
        values.Select((value, index) => FormattableString.Invariant(
            $"{ChartLeft + ((ChartRight - ChartLeft) * index / Math.Max(1, values.Count - 1)):F2},{StorageChartY(value):F2}")));

    private string Point(int index, double value, int count) => FormattableString.Invariant(
        $"{ChartLeft + ((ChartRight - ChartLeft) * index / Math.Max(1, count - 1)):F2},{ChartY(value):F2}");

    private double ChartY(double value) => ChartBottom - ((ChartBottom - ChartTop) * value / _chartMaximumMw);

    private string HeadroomLinePoints(IReadOnlyList<double> values) => string.Join(" ",
        values.Select((value, index) => FormattableString.Invariant(
            $"{ChartLeft + ((ChartRight - ChartLeft) * index / Math.Max(1, values.Count - 1)):F2},{HeadroomChartY(value):F2}")));

    private double HeadroomChartY(double value) =>
        StorageChartBottom
        - ((StorageChartBottom - StorageChartTop) * value / _headroomChartMaximumMw);

    private double StorageChartY(double value) =>
        StorageChartBottom
        - ((StorageChartBottom - StorageChartTop) * value / _storageChartMaximumMwh);

    private string StorageFleetSummary() => _result!.PowerSystem.StorageFleets.Length == 0
        ? "None installed"
        : string.Join(" · ", _result.PowerSystem.StorageFleets.Select(fleet =>
            $"{fleet.Technology} {fleet.EnergyCapacityMwh:N0} MWh / {fleet.PowerCapacityMw:N0} MW"));

    private string CostShareStyle(decimal componentAudPerMwh)
    {
        decimal total = _result!.Cost.SlcoeAudPerMwh;
        decimal percentage = total <= 0 ? 0 : Math.Clamp(100 * componentAudPerMwh / total, 0, 100);
        return FormattableString.Invariant($"width: {percentage:F2}%");
    }

    /// <summary>A money total, abbreviated, with the minus sign outside the currency symbol.</summary>
    private static string FormatAud(decimal value)
    {
        decimal magnitude = Math.Abs(value);
        string sign = value < 0 ? "-" : string.Empty;
        return magnitude switch
        {
            >= 1_000_000_000m => $"{sign}$" + $"{magnitude / 1_000_000_000m:N2}b",
            >= 1_000_000m => $"{sign}$" + $"{magnitude / 1_000_000m:N2}m",
            >= 1_000m => $"{sign}$" + $"{magnitude / 1_000m:N2}k",
            _ => $"{sign}$" + $"{magnitude:N2}",
        };
    }

    private static string FormatAudPerMwh(decimal value) =>
        (value < 0 ? "-$" : "$") + Math.Abs(value).ToString("N2");

    private double AnnualServedEnergyMwh() =>
        _result!.Metrics.DemandMwh - _result.Metrics.UnservedEnergyMwh;

    private bool IsSelected(int index)
    {
        DateTimeOffset instant = InstantAt(index);
        return _selectedView switch { -1 => instant.Date == _selectedDate.Date, 0 => true, _ => instant.Month == _selectedView };
    }

    private DateTimeOffset InstantAt(int index) =>
        _result!.Scenario.PeriodStart.AddTicks(_result.Scenario.Resolution.Ticks * index);

    private static List<MonthOption> BuildMonthOptions(DateTimeOffset start, DateTimeOffset end)
    {
        var months = new List<MonthOption>();
        var month = new DateTimeOffset(start.Year, start.Month, 1, 0, 0, 0, start.Offset);
        while (month < end)
        {
            months.Add(new MonthOption(month.Month, month.ToString("MMMM yyyy")));
            month = month.AddMonths(1);
        }
        return months;
    }

    private static string RegionName(string region) => region switch
    {
        "NSW1" => "New South Wales (NSW1)", "QLD1" => "Queensland (QLD1)",
        "SA1" => "South Australia (SA1)", "TAS1" => "Tasmania (TAS1)",
        "VIC1" => "Victoria (VIC1)", _ => region,
    };

    private sealed record AreaLayer(string Name, string Color, string Points);
    private sealed record StorageTrace(
        string Technology,
        string Color,
        double EnergyCapacityMwh,
        double PowerCapacityMw,
        IReadOnlyList<double> Values,
        string Points = "");
    private sealed record HeadroomTrace(string Name, string Color, string Points);
    private sealed record MonthOption(int Month, string Label);
    private readonly Dictionary<string, RegularSeriesDTO> _baseDemandCache = new(StringComparer.Ordinal);
}