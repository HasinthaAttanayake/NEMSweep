@page "/solar-zenith"
@using NEM.Contracts
@using NEM.Model.Units
@using NEM.Model.Weather
@using System.Globalization
@inject ArtifactLoader ArtifactLoader

<PageTitle>Solar zenith</PageTitle>

<div class="zenith-page">
    <header class="zenith-header">
        <div>
            <p class="eyebrow">Solar geometry</p>
            <h1>Solar zenith</h1>
            @if (_weather is not null)
            {
                <p class="location-line">
                    @RegionNames.Full(_weather.RegionId) ·
                    @_weather.Solar.Location.City ·
                    @_weather.Solar.Location.Latitude.ToString("0.0000"), @_weather.Solar.Location.Longitude.ToString("0.0000")
                </p>
            }
        </div>

        <div class="zenith-controls">
            @if (_regionOptions.Count > 1)
            {
                <MudSelect T="string"
                           Label="Region"
                           Value="_selectedRegion"
                           ValueChanged="OnRegionChanged"
                           Variant="Variant.Outlined"
                           Class="region-select">
                    @foreach (string region in _regionOptions)
                    {
                        <MudSelectItem T="string" Value="region">@RegionNames.Full(region)</MudSelectItem>
                    }
                </MudSelect>
            }

            <label class="date-field">
                <span>Date</span>
                <input type="date"
                       value="@_selectedDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                       @onchange="OnDateChanged" />
            </label>
        </div>
    </header>

    <ArtifactLoadStateView State="_loadState">
        @if (_weather is not null)
        {
        <section class="zenith-summary" aria-label="Selected day summary">
            <div>
                <span>Minimum zenith sample</span>
                <strong>@_minimumZenith.ToString("N1")°</strong>
            </div>
            <div>
                <span>Interval midpoint</span>
                <strong>@_minimumTime</strong>
            </div>
            <div>
                <span>Day</span>
                <strong>@_selectedDate.ToString("dd MMM yyyy")</strong>
            </div>
        </section>

        <section class="chart-section">
            <div class="chart-heading">
                <div>
                    <h2>Hourly geometric zenith angle</h2>
                    <p>0° is directly overhead; 90° is the astronomical horizon</p>
                </div>
                <span class="unit-badge">degrees</span>
            </div>
            <MudChart ChartType="ChartType.Line"
                      ChartSeries="_zenithSeries"
                      ChartLabels="ChartHourLabels"
                      Width="100%"
                      Height="460px" />
        </section>
        }
    </ArtifactLoadStateView>
</div>

@code {
    private static readonly string[] HourLabels =
        Enumerable.Range(0, 24).Select(hour => $"{hour:D2}:30").ToArray();
    private static readonly string[] ChartHourLabels =
        Enumerable.Range(0, 24)
            .Select(hour => hour % 3 == 0 || hour == 23 ? $"{hour:D2}:30" : string.Empty)
            .ToArray();

    private ArtifactLoadState _loadState = ArtifactLoadState.Loading();
    private WeatherDataDTO? _weather;
    private DateTime _selectedDate = DateTime.Today;
    private List<ChartSeries<double>> _zenithSeries = [];
    private double _minimumZenith;
    private string _minimumTime = string.Empty;
    private List<string> _regionOptions = [];
    private Dictionary<string, string> _weatherPathsByRegion = new(StringComparer.OrdinalIgnoreCase);
    private string _selectedRegion = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ArtifactLoadResult<SystemDispatchOverviewDTO> overviewResult =
                await ArtifactLoader.LoadAsync<SystemDispatchOverviewDTO>("data/results-overview.json");
            if (!overviewResult.IsSuccess)
            {
                _loadState = overviewResult.State;
                return;
            }

            if (!RegionArtifactResolver.TryResolveWeatherPaths(
                    overviewResult.Value!.RegionIds,
                    overviewResult.Value.DataSourcesByRegion,
                    out IReadOnlyList<string> regionOptions,
                    out IReadOnlyDictionary<string, string> weatherPathsByRegion,
                    out string? validationMessage))
            {
                _loadState = ArtifactLoadState.InvalidData(validationMessage!);
                return;
            }

            _regionOptions = regionOptions.ToList();
            _weatherPathsByRegion = new Dictionary<string, string>(
                weatherPathsByRegion, StringComparer.OrdinalIgnoreCase);
            _selectedRegion = _regionOptions[0];
            await LoadWeatherAsync(_weatherPathsByRegion[_selectedRegion], _selectedRegion);
        }
        catch (Exception exception)
        {
            _loadState = ArtifactLoadState.Failed($"Error loading weather data: {exception.Message}");
        }
    }

    private async Task OnRegionChanged(string region)
    {
        if (!_weatherPathsByRegion.TryGetValue(region, out string? weatherPath)
            || string.Equals(region, _selectedRegion, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _selectedRegion = region;
        _loadState = ArtifactLoadState.Loading();
        await LoadWeatherAsync(weatherPath, region);
    }

    private async Task LoadWeatherAsync(string path, string expectedRegion)
    {
        ArtifactLoadResult<WeatherDataDTO> loadResult =
            await ArtifactLoader.LoadAsync<WeatherDataDTO>(path);
        if (!loadResult.IsSuccess)
        {
            _loadState = loadResult.State;
            return;
        }

        WeatherDataDTO weather = loadResult.Value!;
        if (!string.Equals(weather.RegionId, expectedRegion, StringComparison.OrdinalIgnoreCase))
        {
            _loadState = ArtifactLoadState.InvalidData(
                $"Weather artifact region {weather.RegionId} does not match selected region {expectedRegion}.");
            return;
        }

        _weather = weather;
        BuildChart();
        _loadState = loadResult.State;
    }

    private void OnDateChanged(ChangeEventArgs args)
    {
        if (DateTime.TryParseExact(
            args.Value?.ToString(),
            "yyyy-MM-dd",
            CultureInfo.InvariantCulture,
            DateTimeStyles.None,
            out DateTime selectedDate))
        {
            _selectedDate = selectedDate;
            BuildChart();
        }
    }

    private void BuildChart()
    {
        if (_weather is null)
        {
            return;
        }

        var start = new DateTimeOffset(
            _selectedDate.Year,
            _selectedDate.Month,
            _selectedDate.Day,
            0,
            0,
            0,
            _weather.Start.Offset);
        SolarZenithSeries series =
            SolarZenithSeries.Calculate(
                start,
                TimeSpan.FromHours(1),
                24,
                _weather.Solar.Location.Latitude,
                _weather.Solar.Location.Longitude);
        double[] values = Enumerable.Range(0, series.Length)
            .Select(index => series[index].Degrees)
            .ToArray();

        int minimumIndex = Array.IndexOf(values, values.Min());
        _minimumZenith = values[minimumIndex];
        _minimumTime = HourLabels[minimumIndex];
        _zenithSeries =
        [
            new ChartSeries<double>
            {
                Name = "Solar zenith (degrees)",
                Data = values,
            },
            new ChartSeries<double>
            {
                Name = "Astronomical horizon (90°)",
                Data = Enumerable.Repeat(90.0, series.Length).ToArray(),
            },
        ];
    }
}