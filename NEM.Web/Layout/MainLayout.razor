@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a class="repository-link"
               href="https://github.com/HasinthaAttanayake/NemSim"
               target="_blank"
               rel="noopener noreferrer">
                <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Small" />
                GitHub repository
            </a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
