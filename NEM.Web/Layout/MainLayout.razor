@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a class="repository-link"
               href="https://github.com/HasinthaAttanayake/NemSim"
               target="_blank"
               rel="noopener noreferrer">
                <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Small" />
                GitHub repository
            </a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    // MudBlazor's stock primary is a purple unrelated to the site's own palette. Every page picks
    // its own accent for its content (demand teal, generation red, wind green — see the per-page
    // --accent custom property), but MudBlazor components have one global theme, so this is set to
    // --color-demand: the accent Home, Regions, Sweep and Dispatch already default to, and the one
    // a reader sees right beside these same components (the loading spinner, the header buttons).
    private static readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#176b5b",
        },
    };
}
