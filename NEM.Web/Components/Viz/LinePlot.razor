@namespace NEM.Web.Components.Viz

@*
    One or two measured series against an evenly spaced categorical x-axis. A second axis is
    supported because the most important comparisons in this model are between quantities in
    different units — a levelised cost that falls while a total cost rises is the finding, and
    splitting it across two charts hides it.
*@
<figure class="line-plot @Class">
    <div class="plot-scroll">
        @* A group rather than an image: the plot contains focusable points, and role="img"
           makes every descendant presentational so none of them reach assistive technology. *@
        <svg viewBox="@($"0 0 1000 {Height}")" role="group" aria-label="@AriaLabel"
             style="@($"aspect-ratio: 1000 / {Height};")">
            @foreach (double tick in _primary.Ticks)
            {
                double y = PlotPath.Y(tick, _box, _primary);
                <line class="plot-grid" x1="@Fmt(_box.Left)" y1="@Fmt(y)" x2="@Fmt(_box.Right)" y2="@Fmt(y)" />
                <SvgText Class="plot-tick" X="_box.Left - 10" Y="y + 4" Anchor="end"
                         Value="@PlotFormat.Tick(tick, _primary, YPrefix)" />
            }
            @if (_secondary is not null)
            {
                @foreach (double tick in _secondary.Ticks)
                {
                    <SvgText Class="plot-tick plot-tick-secondary" X="_box.Right + 10"
                             Y="PlotPath.Y(tick, _box, _secondary) + 4" Anchor="start"
                             Value="@PlotFormat.Tick(tick, _secondary, SecondaryPrefix)" />
                }
            }

            @foreach (PlotAnnotation annotation in Annotations)
            {
                double x = PlotPath.X(annotation.Index, _pointCount, _box);
                <line class="plot-annotation-rule" x1="@Fmt(x)" y1="@Fmt(_box.Top)"
                      x2="@Fmt(x)" y2="@Fmt(_box.Bottom)" />
                <SvgText Class="plot-annotation-label" X="x" Y="_box.Top - 6"
                         Anchor="@(annotation.Index > _pointCount / 2 ? "end" : "start")"
                         Value="@annotation.Label" />
            }

            @foreach (SeriesGeometry geometry in _geometry)
            {
                @if (geometry.Band is not null)
                {
                    <polygon class="plot-fill" points="@geometry.Band" fill="@geometry.Series.Color" />
                }
                @foreach (string segment in geometry.Segments)
                {
                    <polyline class="plot-line @(geometry.Series.Dashed ? "plot-line-dashed" : null)"
                              points="@segment" fill="none" stroke="@geometry.Series.Color"
                              vector-effect="non-scaling-stroke">
                        <title>@geometry.Series.Name</title>
                    </polyline>
                }
                @if (ShowMarkers)
                {
                    @foreach (MarkerPoint marker in geometry.Markers)
                    {
                        <circle class="plot-marker" cx="@Fmt(marker.X)" cy="@Fmt(marker.Y)" r="3.5"
                                fill="@geometry.Series.Color" />
                    }
                }
            }

            <line class="plot-baseline" x1="@Fmt(_box.Left)" y1="@Fmt(_box.Bottom)"
                  x2="@Fmt(_box.Right)" y2="@Fmt(_box.Bottom)" />

            @for (int index = 0; index < _pointCount; index++)
            {
                int position = index;
                double x = PlotPath.X(position, _pointCount, _box);
                double half = _pointCount <= 1 ? _box.Width / 2 : _box.Width / (2.0 * (_pointCount - 1));
                <g class="plot-hit @(SelectedIndex == position ? "is-selected" : null)"
                   role="@(OnSelect.HasDelegate ? "button" : null)"
                   tabindex="@(OnSelect.HasDelegate ? "0" : null)"
                   @onclick="@(() => SelectAsync(position))"
                   @onkeydown="@(args => OnKeyDownAsync(args, position))">
                    <title>@Readout(position)</title>
                    <rect x="@Fmt(Math.Max(_box.Left, x - half))" y="@Fmt(_box.Top)"
                          width="@Fmt(Math.Min(half * 2, _box.Width))" height="@Fmt(_box.Height)"
                          fill="transparent" />
                    <line class="plot-crosshair" x1="@Fmt(x)" y1="@Fmt(_box.Top)"
                          x2="@Fmt(x)" y2="@Fmt(_box.Bottom)" />
                </g>
            }

            @foreach (LabelTick label in _xLabels)
            {
                <SvgText Class="plot-tick" X="label.X" Y="_box.Bottom + 22" Anchor="@label.Anchor"
                         Value="@label.Text" />
            }
            @if (!string.IsNullOrWhiteSpace(XAxisTitle))
            {
                <SvgText Class="plot-axis-title" X="_box.Left + (_box.Width / 2)" Y="Height - 6"
                         Anchor="middle" Value="@XAxisTitle" />
            }
        </svg>
    </div>
    <figcaption class="plot-legend">
        @foreach (PlotSeries series in Series)
        {
            <span>
                <i class="@(series.Dashed ? "dashed" : null)"
                   style="@($"background-color: {series.Color}; color: {series.Color};")"></i>
                @series.Name
                @if (series.UseSecondaryAxis && _secondary is not null)
                {
                    <em>right axis</em>
                }
            </span>
        }
        @if (Caption is not null)
        {
            @Caption
        }
    </figcaption>
</figure>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PlotSeries> Series { get; set; } = [];
    [Parameter] public IReadOnlyList<string> XLabels { get; set; } = [];
    [Parameter] public IReadOnlyList<PlotAnnotation> Annotations { get; set; } = [];
    [Parameter, EditorRequired] public string AriaLabel { get; set; } = string.Empty;
    [Parameter] public string? YPrefix { get; set; }
    [Parameter] public string? SecondaryPrefix { get; set; }
    [Parameter] public string? XAxisTitle { get; set; }
    [Parameter] public double Height { get; set; } = 360;
    [Parameter] public bool IncludeZero { get; set; } = true;
    [Parameter] public bool ShowMarkers { get; set; } = true;
    [Parameter] public int? SelectedIndex { get; set; }
    [Parameter] public EventCallback<int> OnSelect { get; set; }
    [Parameter] public Func<int, string>? ReadoutFor { get; set; }
    [Parameter] public RenderFragment? Caption { get; set; }
    [Parameter] public string? Class { get; set; }

    private PlotBox _box;
    private PlotAxis _primary = PlotAxis.Nice(0, 1);
    private PlotAxis? _secondary;
    private List<SeriesGeometry> _geometry = [];
    private List<LabelTick> _xLabels = [];
    private int _pointCount;

    protected override void OnParametersSet()
    {
        _pointCount = Series.Count == 0 ? 0 : Series.Max(series => series.Values.Count);
        bool hasSecondary = Series.Any(series => series.UseSecondaryAxis);
        // Right-hand tick labels need the same room the left-hand ones get, and only when drawn.
        _box = new PlotBox(
            76,
            Annotations.Count > 0 ? 30 : 20,
            hasSecondary ? 912 : 976,
            Height - (string.IsNullOrWhiteSpace(XAxisTitle) ? 34 : 52));

        _primary = AxisFor(series => !series.UseSecondaryAxis) ?? PlotAxis.Nice(0, 1, includeZero: IncludeZero);
        _secondary = hasSecondary ? AxisFor(series => series.UseSecondaryAxis) : null;

        _geometry = [.. Series.Select(BuildGeometry)];
        _xLabels = BuildXLabels();
    }

    private PlotAxis? AxisFor(Func<PlotSeries, bool> predicate)
    {
        double[] values = [.. Series.Where(predicate)
            .SelectMany(series => series.Values)
            .Where(value => value.HasValue && !double.IsNaN(value!.Value) && !double.IsInfinity(value.Value))
            .Select(value => value!.Value)];
        return values.Length == 0
            ? null
            : PlotAxis.Nice(values.Min(), values.Max(), includeZero: IncludeZero);
    }

    private SeriesGeometry BuildGeometry(PlotSeries series)
    {
        PlotAxis axis = series.UseSecondaryAxis && _secondary is not null ? _secondary : _primary;
        var markers = new List<MarkerPoint>();
        for (int index = 0; index < series.Values.Count; index++)
        {
            if (series.Values[index] is { } value)
            {
                markers.Add(new MarkerPoint(
                    PlotPath.X(index, _pointCount, _box),
                    PlotPath.Y(value, _box, axis)));
            }
        }

        string? band = null;
        if (series.Filled && series.Values.Count > 0 && series.Values.All(value => value.HasValue))
        {
            double floor = Math.Max(axis.Minimum, 0);
            band = PlotPath.Band(
                [.. series.Values.Select(_ => floor)],
                [.. series.Values.Select(value => value!.Value)],
                _box,
                axis);
        }

        return new SeriesGeometry(series, PlotPath.Segments(series.Values, _box, axis), markers, band);
    }

    /// <summary>
    /// Labels every point when they fit and every nth otherwise. A crowded axis of overlapping
    /// labels is worse than a sparse one: the reader can still count positions between labels.
    /// </summary>
    private List<LabelTick> BuildXLabels()
    {
        if (XLabels.Count == 0 || _pointCount == 0)
        {
            return [];
        }

        int stride = Math.Max(1, (int)Math.Ceiling(XLabels.Count / 9.0));
        var labels = new List<LabelTick>();
        for (int index = 0; index < XLabels.Count; index += stride)
        {
            labels.Add(Label(index));
        }

        // The last point carries the sweep's end state, so it is always labelled.
        if ((XLabels.Count - 1) % stride != 0)
        {
            labels.Add(Label(XLabels.Count - 1));
        }

        return labels;
    }

    /// <summary>
    /// One x-axis label, shortened to what the spacing allows and anchored so the first and last
    /// cannot hang off the edge of the viewBox. Every point still carries its full name in the
    /// readout, so shortening the axis loses nothing.
    /// </summary>
    private LabelTick Label(int index)
    {
        string anchor = index == 0 ? "start" : index == XLabels.Count - 1 ? "end" : "middle";
        return new LabelTick(PlotPath.X(index, _pointCount, _box), Shorten(XLabels[index]), anchor);
    }

    private static string Shorten(string text) =>
        text.Length <= MaximumLabelLength ? text : text[..(MaximumLabelLength - 1)].TrimEnd() + "…";

    /// <summary>The text a reader gets from hovering or focusing a position on the plot.</summary>
    private string Readout(int index)
    {
        if (ReadoutFor is not null)
        {
            return ReadoutFor(index);
        }

        string heading = index < XLabels.Count ? XLabels[index] : $"Point {index + 1}";
        IEnumerable<string> lines = Series
            .Where(series => index < series.Values.Count && series.Values[index].HasValue)
            .Select(series =>
            {
                string prefix = series.UseSecondaryAxis ? SecondaryPrefix ?? string.Empty : YPrefix ?? string.Empty;
                double value = series.Values[index]!.Value;
                string formatted = PlotFormat.Compact(value, 2);
                return $"{series.Name}: {(value < 0 ? $"-{prefix}{formatted.TrimStart('-')}" : prefix + formatted)}";
            });
        return string.Join("\n", lines.Prepend(heading));
    }

    private async Task SelectAsync(int index)
    {
        if (OnSelect.HasDelegate)
        {
            await OnSelect.InvokeAsync(index);
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs args, int index)
    {
        if (args.Key is "Enter" or " ")
        {
            await SelectAsync(index);
        }
    }

    private static string Fmt(double value) => PlotFormat.Length(value);

    private sealed record SeriesGeometry(
        PlotSeries Series,
        IReadOnlyList<string> Segments,
        IReadOnlyList<MarkerPoint> Markers,
        string? Band);

    private readonly record struct MarkerPoint(double X, double Y);

    private readonly record struct LabelTick(double X, string Text, string Anchor);

    /// <summary>
    /// The widest an axis label can be before neighbouring labels collide. Nine labels across a
    /// 900-unit plot leaves about 100 units each, which is roughly this many characters at the
    /// tick font size.
    /// </summary>
    private const int MaximumLabelLength = 16;
}
