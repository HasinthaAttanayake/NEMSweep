@namespace NEM.Web.Components.Viz

@*
    One measure across a handful of named things, with an optional reference line. The reference is
    what makes this worth drawing for this model: a regional figure only means something against
    the system figure, and a bar that crosses the reference is a different result from one that
    does not.
*@
<div class="compare-bars @Class" role="img" aria-label="@AriaLabel">
    @foreach (CompareRowGeometry row in _rows)
    {
        <div class="compare-row @(row.Source.IsMuted ? "is-muted" : null)">
            <span class="compare-label">@row.Source.Label</span>
            <div class="compare-track">
                <i style="@($"width: {PlotFormat.Length(row.Percentage)}%; background-color: {row.Source.Color ?? "var(--accent, #176b5b)"};")"></i>
                @if (_referencePercentage is { } reference)
                {
                    <b style="@($"left: {PlotFormat.Length(reference)}%")" aria-hidden="true"></b>
                }
            </div>
            <strong class="compare-value">@row.Source.Display</strong>
        </div>
    }
    @if (Reference is not null && !string.IsNullOrWhiteSpace(ReferenceLabel))
    {
        <p class="compare-reference">@ReferenceLabel</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CompareRow> Rows { get; set; } = [];
    [Parameter, EditorRequired] public string AriaLabel { get; set; } = string.Empty;
    [Parameter] public double? Reference { get; set; }
    [Parameter] public string? ReferenceLabel { get; set; }
    [Parameter] public string? Class { get; set; }

    private List<CompareRowGeometry> _rows = [];
    private double? _referencePercentage;

    protected override void OnParametersSet()
    {
        // Bars are drawn from zero against the largest value on show, including the reference, so
        // the reference marker cannot fall off the end of every track.
        double maximum = Rows.Select(row => Math.Abs(row.Value))
            .Append(Math.Abs(Reference ?? 0))
            .DefaultIfEmpty(0)
            .Max();
        _rows = [.. Rows.Select(row => new CompareRowGeometry(
            row,
            maximum <= 0 ? 0 : 100 * Math.Clamp(Math.Abs(row.Value) / maximum, 0, 1)))];
        _referencePercentage = Reference is null || maximum <= 0
            ? null
            : 100 * Math.Clamp(Math.Abs(Reference.Value) / maximum, 0, 1);
    }

    private readonly record struct CompareRowGeometry(CompareRow Source, double Percentage);
}
