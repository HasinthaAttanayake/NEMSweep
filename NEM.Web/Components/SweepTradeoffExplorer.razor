@using NEM.Contracts
@using NEM.Web.Components.Viz
@using NEM.Web.Services
@using NEM.Web.Services.Insights

@*
    Any measure against any other, one marker per run. A sweep plotted against its own input says
    what happened; plotted measure against measure it says what was traded for what — which is the
    question a reader actually arrives with.
*@
<section class="tradeoff" aria-labelledby="tradeoff-heading">
    <div class="tradeoff-heading">
        <div>
            <p class="section-index">Trade-offs</p>
            <h2 id="tradeoff-heading">Put any two results against each other</h2>
            <p>
                Markers follow sweep order along the dashed path, so a path that doubles back is a
                sweep where more of the input stopped buying more of the outcome. Select a marker to
                open that run.
            </p>
        </div>
        <div class="tradeoff-controls">
            <MudSelect T="string" Label="Horizontal" Value="_xKey" ValueChanged="OnXChanged"
                       Variant="Variant.Outlined" Class="tradeoff-select">
                @foreach (SweepMeasure measure in _available)
                {
                    <MudSelectItem T="string" Value="@measure.Key">@Option(measure)</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" Label="Vertical" Value="_yKey" ValueChanged="OnYChanged"
                       Variant="Variant.Outlined" Class="tradeoff-select">
                @foreach (SweepMeasure measure in _available)
                {
                    <MudSelectItem T="string" Value="@measure.Key">@Option(measure)</MudSelectItem>
                }
            </MudSelect>
        </div>
    </div>

    @if (_markers.Count < 2)
    {
        <MudAlert Severity="Severity.Info" Class="tradeoff-empty">
            This sweep does not carry both of the selected measures for enough runs to plot them
            against each other.
        </MudAlert>
    }
    else
    {
        <ScatterPlot Markers="@_markers"
                     AriaLabel="@($"{_y.Label} against {_x.Label} across the sweep")"
                     XAxisTitle="@_x.AxisTitle"
                     YAxisTitle="@_y.AxisTitle"
                     XPrefix="@_x.Prefix"
                     YPrefix="@_y.Prefix"
                     Height="420">
            <Caption>
                @if (_x.IsDerived || _y.IsDerived)
                {
                    <span>
                        Annual system cost is derived: it is the run's levelised cost multiplied by
                        the energy it served.
                    </span>
                }
                @if (_relationship is { Length: > 0 })
                {
                    <span class="tradeoff-relationship">@_relationship</span>
                }
            </Caption>
        </ScatterPlot>
    }
</section>

@code {
    [Parameter, EditorRequired] public SweepAnalysis Analysis { get; set; } = default!;
    [Parameter] public string? RegionId { get; set; }

    private IReadOnlyList<SweepMeasure> _measures = [];
    private List<SweepMeasure> _available = [];
    private SweepMeasure _x = default!;
    private SweepMeasure _y = default!;
    private string _xKey = string.Empty;
    private string _yKey = SweepMeasures.LevelisedCostKey;
    private List<PlotMarker> _markers = [];
    private string? _relationship;
    private string? _builtForSweepId;

    protected override void OnParametersSet()
    {
        _measures = SweepMeasures.For(Analysis.Index);
        // Only measures the runs actually carry a value for are offered, so the selector cannot
        // produce an empty chart.
        _available = [.. _measures.Where(measure =>
            Analysis.Runs.Any(run => measure.Select(run).HasValue))];

        string identity = $"{Analysis.Index.SweepId}|{RegionId}";
        if (_builtForSweepId != identity)
        {
            _builtForSweepId = identity;
            _xKey = SweepMeasures.DefaultX(_available, Analysis.Runs).Key;
            _yKey = SweepMeasures.Resolve(_available, SweepMeasures.LevelisedCostKey).Key;
        }

        Build();
    }

    private void Build()
    {
        _x = SweepMeasures.Resolve(_available, _xKey);
        _y = SweepMeasures.Resolve(_available, _yKey);

        int? turningIndex = Analysis.UnitCostTurningPoint?.Index;
        var markers = new List<PlotMarker>();
        for (int index = 0; index < Analysis.Runs.Count; index++)
        {
            SweepRun run = Analysis.Runs[index];
            if (_x.Select(run) is not { } x || _y.Select(run) is not { } y)
            {
                continue;
            }

            markers.Add(new PlotMarker(
                run.Label,
                x,
                y,
                SweepPaths.RunRoute(Analysis.Index.SweepId, run.Point.PointId, RegionId),
                index == turningIndex,
                $"{Analysis.AxisLabel}: {run.AxisValue:N2} {Analysis.AxisUnit}"));
        }

        _markers = markers;
        _relationship = DescribeRelationship(markers);
    }

    /// <summary>
    /// States what the cloud does between its ends, and whether it stays monotone in between. This
    /// is a description of the drawn points, not a fitted model: no trend line is claimed.
    /// </summary>
    private string? DescribeRelationship(IReadOnlyList<PlotMarker> markers)
    {
        if (markers.Count < 3 || _x.Key == _y.Key)
        {
            return null;
        }

        double xChange = markers[^1].X - markers[0].X;
        double yChange = markers[^1].Y - markers[0].Y;
        if (xChange == 0 || yChange == 0)
        {
            return null;
        }

        bool reverses = false;
        int direction = Math.Sign(markers[1].Y - markers[0].Y);
        for (int index = 2; index < markers.Count; index++)
        {
            int step = Math.Sign(markers[index].Y - markers[index - 1].Y);
            if (step != 0 && direction != 0 && step != direction)
            {
                reverses = true;
                break;
            }

            direction = step == 0 ? direction : step;
        }

        string movement = Math.Sign(xChange) == Math.Sign(yChange)
            ? $"Across the sweep, {_y.Label.ToLowerInvariant()} moves with {_x.Label.ToLowerInvariant()}"
            : $"Across the sweep, {_y.Label.ToLowerInvariant()} moves against {_x.Label.ToLowerInvariant()}";
        return reverses
            ? $"{movement} overall, but not at every run — the path reverses direction part way through."
            : $"{movement} at every run in the sweep.";
    }

    private void OnXChanged(string key)
    {
        _xKey = key;
        Build();
    }

    private void OnYChanged(string key)
    {
        _yKey = key;
        Build();
    }

    private static string Option(SweepMeasure measure) =>
        string.IsNullOrWhiteSpace(measure.Unit) ? measure.Label : $"{measure.Label} ({measure.Unit})";
}
