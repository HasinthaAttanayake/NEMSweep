@using NEM.Contracts
@using System.Globalization
@using NEM.Web.Components.Viz
@using NEM.Web.Services
@using NEM.Web.Services.Insights

@*
    Every region of a system run over the same period, on the same axes. The scope selector shows
    one region at a time, which answers "what did Victoria do" but never "what were they doing to
    each other" — and a two-region model with an interconnector exists to answer the second.
*@
<section class="region-compare" aria-labelledby="region-compare-heading">
    <div class="section-heading">
        <p class="section-label">All regions</p>
        <h2 id="region-compare-heading">Every region over the same hours</h2>
        <p>
            One panel per region, drawn to a shared vertical scale so the areas are comparable
            directly. The demand trace is the region's own; where it rises above the stack, the
            shortfall is met by imports or not at all.
        </p>
    </div>

    <div class="compare-export">
        <CsvDownload Headers="@CsvHeaders"
                     Rows="@CsvRows"
                     FileName="@CsvWriter.FileName("regions", PeriodLabel)"
                     Label="Download this period" />
    </div>

    <div class="compare-metrics">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">Region</th>
                    <th scope="col">Peak demand</th>
                    <th scope="col">Demand energy</th>
                    <th scope="col">Delivered</th>
                    <th scope="col">Renewable</th>
                    <th scope="col">Curtailed</th>
                    <th scope="col">Unserved</th>
                    <th scope="col">Peak shortfall</th>
                </tr>
            </thead>
            <tbody>
                @foreach (RegionPanel panel in _panels)
                {
                    <tr>
                        <th scope="row">@panel.Name</th>
                        <td>@PlotFormat.Compact(panel.PeakDemandMw) MW</td>
                        <td>@PlotFormat.Compact(panel.DemandMwh) MWh</td>
                        <td>@PlotFormat.Compact(panel.DeliveredMwh) MWh</td>
                        <td>@PlotFormat.Share(panel.RenewableShare)</td>
                        <td>@PlotFormat.Compact(panel.CurtailedMwh) MWh</td>
                        <td class="@(panel.UnservedMwh > 0 ? "cell-shortfall" : null)">
                            @PlotFormat.Compact(panel.UnservedMwh) MWh
                        </td>
                        <td class="@(panel.PeakUnservedMw > 0 ? "cell-shortfall" : null)">
                            @PlotFormat.Compact(panel.PeakUnservedMw) MW
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="compare-scope-note">Figures cover @PeriodLabel, not the whole run.</p>

    <div class="compare-panels">
        @foreach (RegionPanel panel in _panels)
        {
            <StackPlot Series="@panel.Layers"
                       Demand="@panel.Demand"
                       Axis="@_sharedAxis"
                       XLabels="@_labels"
                       Title="@panel.Name"
                       Detail="@($"peak {PlotFormat.Compact(panel.PeakDemandMw)} MW · {PlotFormat.Share(panel.RenewableShare)} renewable")"
                       AriaLabel="@($"{panel.Name} delivered generation by technology against demand")"
                       Height="230" />
        }
    </div>

    <div class="compare-legend">
        @foreach (string technology in _technologies)
        {
            <span>
                <i style="@($"background-color: {TechnologyPalette.ForGeneration(technology)}")"></i>@technology
            </span>
        }
        <span><i class="demand-key"></i>Demand</span>
        <span class="compare-axis-note">Shared axis to @PlotFormat.Compact(_sharedAxis.Maximum) MW</span>
    </div>

    @if (_links.Count > 0)
    {
        <div class="compare-trade">
            <h3>Trade between them over @PeriodLabel</h3>
            <ul>
                @foreach (LinkWindow link in _links)
                {
                    <li class="@(link.EnergyMwh <= 0 ? "is-idle" : null)">
                        <strong>@link.Label</strong>
                        <span>@PlotFormat.Compact(link.EnergyMwh) MWh</span>
                        <small>
                            @if (link.EnergyMwh <= 0)
                            {
                                @:did not carry energy in this period
                            }
                            else
                            {
                                @($"{link.FlowingIntervals:N0} of {link.TotalIntervals:N0} intervals · peak {PlotFormat.Compact(link.PeakMw)} MW of {PlotFormat.Compact(link.CapacityMw)} MW")
                            }
                        </small>
                    </li>
                }
            </ul>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<RegionEvidence> Regions { get; set; } = [];
    [Parameter, EditorRequired] public DispatchWindow Window { get; set; } = default!;
    [Parameter, EditorRequired] public TimeSpan Resolution { get; set; }
    [Parameter, EditorRequired] public string PeriodLabel { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<DispatchInterconnectorDTO> Interconnectors { get; set; } = [];

    private static readonly string[] CsvHeaders =
    [
        "Region",
        "Peak demand (MW)",
        "Demand energy (MWh)",
        "Delivered (MWh)",
        "Renewable share",
        "Curtailed (MWh)",
        "Unserved (MWh)",
        "Peak shortfall (MW)",
    ];

    /// <summary>
    /// Unrounded figures rather than the abbreviated ones on screen: a spreadsheet is where someone
    /// goes to do arithmetic, and "2.9M MWh" cannot be added up.
    /// </summary>
    private IReadOnlyList<IReadOnlyList<string>> CsvRows =>
    [
        .. _panels.Select(panel => (IReadOnlyList<string>)
        [
            panel.Name,
            Number(panel.PeakDemandMw),
            Number(panel.DemandMwh),
            Number(panel.DeliveredMwh),
            Number(panel.RenewableShare),
            Number(panel.CurtailedMwh),
            Number(panel.UnservedMwh),
            Number(panel.PeakUnservedMw),
        ]),
    ];

    /// <summary>Shortest round-trippable form, so an exported figure is the model's own value.</summary>
    private static string Number(double value) => value.ToString(CultureInfo.InvariantCulture);

    private List<RegionPanel> _panels = [];
    private List<LinkWindow> _links = [];
    private List<string> _technologies = [];
    private List<string> _labels = [];
    private PlotAxis _sharedAxis = PlotAxis.Nice(0, 1);

    protected override void OnParametersSet()
    {
        _technologies = [.. TechnologyPalette.Order(Regions
            .SelectMany(region => region.Result.DataSeries.DeliveredGenerationByTechnologyMw.Keys)
            .Distinct(StringComparer.OrdinalIgnoreCase))];

        _panels = [.. Regions.Select(BuildPanel)];

        // One scale across every panel: a region drawn to its own maximum reads as though it were
        // the same size as its neighbour, which is the opposite of what a comparison is for.
        double maximum = _panels.Count == 0
            ? 1
            : _panels.Max(panel => Math.Max(
                panel.Demand.DefaultIfEmpty(0).Max(),
                Enumerable.Range(0, panel.Demand.Count)
                    .Select(index => panel.Layers.Sum(layer => layer.Values[index] ?? 0))
                    .DefaultIfEmpty(0)
                    .Max()));
        _sharedAxis = PlotAxis.Nice(0, maximum);

        string format = Window.PointCount > 40 ? "MMM" : Window.PointCount > 26 ? "dd MMM" : "HH:mm";
        _labels = [.. Window.Timestamps.Select(timestamp => timestamp.ToString(format))];
        _links = [.. (Interconnectors ?? []).Select(BuildLink)];
    }

    private RegionPanel BuildPanel(RegionEvidence region)
    {
        DispatchSeriesDTO series = region.Result.DataSeries;
        var layers = new List<PlotSeries>();
        double deliveredMwh = 0;
        double renewableMwh = 0;
        foreach (string technology in _technologies)
        {
            double[]? source = series.DeliveredGenerationByTechnologyMw.GetValueOrDefault(technology);
            layers.Add(new PlotSeries(
                technology,
                TechnologyPalette.ForGeneration(technology),
                [.. Window.Average(source).Select(value => (double?)value)]));
            double energy = Window.Integrate(source, Resolution);
            deliveredMwh += energy;
            if (TechnologyPalette.Renewable.Contains(technology))
            {
                renewableMwh += energy;
            }
        }

        double[] demand = Window.Average(series.Demand.TotalDemandMw);
        return new RegionPanel(
            RegionNames.Full(region.RegionId),
            layers,
            demand,
            Window.Maximum(series.Demand.TotalDemandMw),
            Window.Integrate(series.Demand.TotalDemandMw, Resolution),
            deliveredMwh,
            deliveredMwh <= 0 ? 0 : renewableMwh / deliveredMwh,
            Window.Integrate(series.CurtailmentMw, Resolution),
            Window.Integrate(series.UnservedDemandMw, Resolution),
            Window.Maximum(series.UnservedDemandMw));
    }

    private LinkWindow BuildLink(DispatchInterconnectorDTO link)
    {
        double[] flow = link.FlowMw ?? [];
        int flowing = Window.Indexes.Count(index => index < flow.Length && flow[index] > 0);
        return new LinkWindow(
            $"{link.FromRegionId} to {link.ToRegionId}",
            link.CapacityMw,
            Window.Integrate(flow, Resolution),
            Window.Maximum(flow),
            flowing,
            Window.IntervalCount);
    }

    /// <summary>One region's dispatch evidence, already resolved by the page that owns the fetch.</summary>
    public sealed record RegionEvidence(string RegionId, DispatchResultsDTO Result);

    private sealed record RegionPanel(
        string Name,
        IReadOnlyList<PlotSeries> Layers,
        IReadOnlyList<double> Demand,
        double PeakDemandMw,
        double DemandMwh,
        double DeliveredMwh,
        double RenewableShare,
        double CurtailedMwh,
        double UnservedMwh,
        double PeakUnservedMw);

    private sealed record LinkWindow(
        string Label,
        double CapacityMw,
        double EnergyMwh,
        double PeakMw,
        int FlowingIntervals,
        int TotalIntervals);
}
