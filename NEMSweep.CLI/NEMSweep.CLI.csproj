<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>nemsweep</AssemblyName>
    <!-- The published docs site is generated from these comments, so a gap is a build break:
         CS1591 a missing comment, CS1572/CS1573 param tags out of step with the signature,
         CS1574 a cross-reference that will not resolve. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1572;CS1573;CS1574;CS1591</WarningsAsErrors>
  </PropertyGroup>

  <!--
    Container image, built by the SDK rather than a Dockerfile, so there is no daemon in the build
    and no second description of the app to keep in step.

    Framework-dependent on a chiseled runtime base: a .NET security fix then becomes a rebase rather
    than a recompile, the runtime layer is shared, and chiseled keeps the CVE surface small enough
    to clear a registry scanner and runs as a non-root user by default, which is what stops
    bind-mounted output landing root-owned.

    Deliberately not trimmed and not AOT: ClosedXML and OpenXml resolve types by reflection, so
    trimming would break workbook and archive ingestion at run time while the build stayed green.
  -->
  <PropertyGroup>
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerFamily>noble-chiseled</ContainerFamily>
    <ContainerRepository>hasinthaattanayake/nemsweep</ContainerRepository>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <ContainerRuntimeIdentifiers>linux-x64;linux-arm64</ContainerRuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- The image's own defaults for the two roots, so a run is a pair of mounts and nothing else.
         Data lives outside the image by design; the settings file baked into it sits in a
         read-only layer, which is why these are environment variables. -->
    <ContainerEnvironmentVariable Include="NEMSWEEP_DATA_ROOT" Value="/data" />
    <ContainerEnvironmentVariable Include="NEMSWEEP_OUTPUT" Value="/out" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NEMSweep.Contracts\NEMSweep.Contracts.csproj" />
    <ProjectReference Include="..\NEMSweep.Model\NEMSweep.Model.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.local.json" Condition="Exists('appsettings.local.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
