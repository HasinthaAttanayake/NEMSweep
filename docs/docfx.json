{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "NEMSweep.Model/NEMSweep.Model.csproj",
            "NEMSweep.Contracts/NEMSweep.Contracts.csproj"
          ]
        }
      ],
      "dest": "api",
      "filter": "filterConfig.yml",
      "namespaceLayout": "nested",
      "memberLayout": "separatePages",
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "obj/**",
          "filterConfig.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "_headers"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "template"
    ],
    "globalMetadata": {
      "_appName": "NEMSweep",
      "_appTitle": "NEMSweep",
      "_appLogoPath": "images/logo.svg",
      "_appFaviconPath": "images/favicon.svg",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/HasinthaAttanayake/NEMSweep",
        "branch": "main"
      },
      "_appFooter": "<div class=\"nem-footer\"><div class=\"nem-footer-brand\"><img src=\"/images/logo.svg\" alt=\"\" width=\"22\" height=\"22\" /><span>NEM<em>Sweep</em></span></div><p class=\"nem-footer-line\">An open dispatch, reliability and cost model for Australia\u2019s National Electricity Market. Figures in these pages are modelled build-and-run costs, not retail prices.</p><p class=\"nem-footer-links\"><a href=\"https://nemsweep.com/\">Open the model</a><a href=\"https://github.com/HasinthaAttanayake/NEMSweep\">Source</a><a href=\"https://github.com/HasinthaAttanayake/NEMSweep/blob/main/LICENSE.md\">BSD 3-Clause licence</a></p></div>"
    },
    "postProcessors": [
      "ExtractSearchIndex"
    ],
    "keepFileLink": false,
    "disableGitFeatures": false
  }
}
