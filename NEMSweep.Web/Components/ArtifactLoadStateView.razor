@using NEMSweep.Web.Services

@if (State.Status == ArtifactLoadStatus.Loading)
{
    <div class="status-block">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </div>
}
else if (State.Status == ArtifactLoadStatus.Success)
{
    @ChildContent
}
else if (State.Status is ArtifactLoadStatus.Empty or ArtifactLoadStatus.NotFound)
{
    <MudAlert Severity="Severity.Info">@State.Message</MudAlert>
}
else
{
    <MudAlert Severity="Severity.Error">@State.Message</MudAlert>
}

@code {
    [Parameter, EditorRequired]
    public ArtifactLoadState State { get; set; } = ArtifactLoadState.Loading();

    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }
}