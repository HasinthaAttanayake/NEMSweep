@using NEMSweep.Contracts
@using NEMSweep.Web.Components.Viz
@inject NavigationManager Navigation

<ChartFrame Heading="@Heading" Description="@Description" Unit="@YAxis.Unit">
    <div class="sweep-chart" aria-label="@($"{YAxis.Label} by {Index.Axis.Label}")">
        @if (_chart.Points.Count == 0)
        {
            <MudAlert Severity="Severity.Info">No achieved sweep results are available.</MudAlert>
        }
        else
        {
            <LinePlot Series="@_series"
                      XLabels="@_labels"
                      AriaLabel="@($"{YAxis.Label} by {Index.Axis.Label}")"
                      YPrefix="@YAxis.ValuePrefix"
                      XAxisTitle="@($"{Index.Axis.Label} ({Index.Axis.Unit})")"
                      YAxisTitle="@YAxis.Unit"
                      Height="380"
                      ReadoutFor="Readout"
                      OnSelect="OpenRun" />
        }
    </div>

    @if (_chart.OmittedPoints.Count > 0)
    {
        <section class="sweep-omissions" aria-label="Sweep points not plotted">
            <h3>@_chart.OmittedPoints.Count of @Index.Points.Length points are not plotted</h3>
            <ul>
                @foreach (SweepChartOmittedPoint point in _chart.OmittedPoints)
                {
                    <li>
                        <strong>@point.Label (@point.AxisValue.ToString(_axisFormat) @Index.Axis.Unit)</strong>
                        <span>@point.Reason</span>
                    </li>
                }
            </ul>
        </section>
    }
</ChartFrame>

@code {
    [Parameter, EditorRequired] public SweepIndexDTO Index { get; set; } = default!;
    [Parameter, EditorRequired] public SweepChartYAxis YAxis { get; set; } = default!;
    [Parameter] public string? RegionId { get; set; }
    [Parameter, EditorRequired] public string Heading { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public Func<SweepIndexPointDTO, string?>? DrillDownTarget { get; set; }

    private SweepChartData _chart = new([], [], [], []);
    private string _axisFormat = "N0";
    private List<PlotSeries> _series = [];
    private List<string> _labels = [];

    protected override void OnParametersSet()
    {
        _chart = SweepChartData.Build(Index, YAxis, RegionId);
        // A fractional axis such as 0.1-0.4 rounds to "0" under a whole-number format.
        _axisFormat = SweepValueFormat.ColumnFormat(Index.Points.Select(point => (double?)point.AxisValue));
        _labels = [.. _chart.Points.Select(point => point.Point.Label)];
        _series =
        [
            PlotSeries.From(
                $"{YAxis.Label} ({YAxis.Unit})",
                "var(--color-demand)",
                _chart.Values,
                filled: true),
        ];
    }

    private string Readout(int index)
    {
        if (index < 0 || index >= _chart.Points.Count)
        {
            return string.Empty;
        }

        SweepChartPoint point = _chart.Points[index];
        return $"{point.Point.Label} ({point.Point.AxisValue.ToString(_axisFormat)} {Index.Axis.Unit})"
            + $"\n{YAxis.Label}: {SweepValueFormat.Short(point.Value, YAxis.ValuePrefix)} {YAxis.Unit}";
    }

    private void OpenRun(int index)
    {
        if (index < 0 || index >= _chart.Points.Count || DrillDownTarget is null)
        {
            return;
        }

        string? target = DrillDownTarget(_chart.Points[index].Point);
        if (!string.IsNullOrWhiteSpace(target))
        {
            Navigation.NavigateTo(target);
        }
    }
}
