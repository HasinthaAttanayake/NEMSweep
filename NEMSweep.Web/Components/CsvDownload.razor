@using NEMSweep.Web.Services

@*
    A table as a file. The href carries the whole CSV, so this needs no script and no round trip —
    these tables are tens of rows, well inside what an address can hold.
*@
<a class="csv-download @Class" href="@_href" download="@FileName">
    <MudIcon Icon="@Icons.Material.Filled.FileDownload" Size="Size.Small" />
    @Label
</a>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<string> Headers { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<IReadOnlyList<string>> Rows { get; set; } = [];
    [Parameter, EditorRequired] public string FileName { get; set; } = "export.csv";
    [Parameter] public string Label { get; set; } = "Download CSV";
    [Parameter] public string? Class { get; set; }

    private string _href = string.Empty;

    protected override void OnParametersSet() =>
        _href = CsvWriter.ToDataUri(CsvWriter.Build(Headers, Rows));
}
