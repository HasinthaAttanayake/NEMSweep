@using NEMSweep.Contracts
@using NEMSweep.Web.Components.Viz
@using NEMSweep.Web.Services.Insights

@*
    The generation bill split by the fleet that incurred it, against the energy that fleet
    delivered.

    The three-way generation, storage and transmission split answers which bucket the money fell
    in. This answers which fleet, which is the decomposition a reader of a renewable-target result
    is actually after — and the gap between a technology's share of the bill and its share of the
    energy is the whole finding.
*@
@if (Cost.Entries.Count > 0)
{
    <div class="cost-by-fleet">
        <div class="cost-mix-pair">
            <MixBar Segments="@Cost.CostSegments()"
                    Label="Annual generation cost"
                    AriaLabel="@($"{Scope} generation cost by technology")"
                    Detail="@PlotFormat.MoneyTotal(Cost.TotalAnnualisedCostAud)"
                    Money="true" />
            <MixBar Segments="@Cost.EnergySegments()"
                    Label="Delivered energy"
                    AriaLabel="@($"{Scope} delivered generation by technology")"
                    Detail="@($"{PlotFormat.Compact(Mix.TotalMwh)} MWh")" />
        </div>

        @if (ShowTable)
        {
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th scope="col">Technology</th>
                            <th scope="col">Annual cost</th>
                            <th scope="col">Share of bill</th>
                            <th scope="col">Share of energy</th>
                            <th scope="col">Cost of its own energy</th>
                            <th scope="col">Contribution to levelised cost</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (CostEntry entry in Cost.Entries)
                        {
                            <tr>
                                <th scope="row">
                                    <i class="swatch" style="@($"background:{entry.Color};")" aria-hidden="true"></i>
                                    @entry.Technology
                                </th>
                                <td>@PlotFormat.MoneyTotal(entry.AnnualisedCostAud)</td>
                                <td>@PlotFormat.Share(entry.CostShare)</td>
                                <td>@(entry.EnergyMwh > 0 ? PlotFormat.Share(entry.EnergyShare) : "—")</td>
                                <td>@(entry.EnergyMwh > 0 ? $"{PlotFormat.Money(entry.AudPerOwnMwh)}/MWh" : "—")</td>
                                <td class="cell-emphasis">@PlotFormat.Money(entry.LevelisedContributionAudPerMwh)/MWh</td>
                            </tr>
                        }
                        <tr class="row-derived">
                            <th scope="row">All generation</th>
                            <td>@PlotFormat.MoneyTotal(Cost.TotalAnnualisedCostAud)</td>
                            <td>@PlotFormat.Share(1)</td>
                            <td>@(Mix.TotalMwh > 0 ? PlotFormat.Share(1) : "—")</td>
                            <td></td>
                            <td class="cell-emphasis">@PlotFormat.Money(GenerationSlcoeAudPerMwh)/MWh</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }

        @* The contract requires the contributions to reconcile exactly to the published generation
           cost. If they ever do not, that is a defect in the artifact and the reader should be told
           rather than shown a table that quietly disagrees with the figure above it. *@
        @if (!Cost.ReconcilesTo(AnnualisedGenerationCostAud))
        {
            <MudAlert Severity="Severity.Warning" Class="reconcile-alert">
                These contributions total @PlotFormat.MoneyTotal(Cost.TotalAnnualisedCostAud)
                against a published generation cost of
                @PlotFormat.MoneyTotal(AnnualisedGenerationCostAud). The artifact does not reconcile.
            </MudAlert>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public CostByTechnology Cost { get; set; } = CostByTechnology.Empty;
    [Parameter, EditorRequired] public EnergyMix Mix { get; set; } = EnergyMix.Empty;

    /// <summary>What the decomposition is of — a region name, or the system. Used in labels only.</summary>
    [Parameter, EditorRequired] public string Scope { get; set; } = string.Empty;

    [Parameter] public decimal GenerationSlcoeAudPerMwh { get; set; }
    [Parameter] public decimal AnnualisedGenerationCostAud { get; set; }

    /// <summary>False where the two bars carry the point and a six-column table would not.</summary>
    [Parameter] public bool ShowTable { get; set; } = true;
}
