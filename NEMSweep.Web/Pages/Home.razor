@page "/"
@layout MarketingLayout
@using System.Globalization
@using NEMSweep.Contracts
@using NEMSweep.Web.Components.Viz
@using NEMSweep.Web.Services
@using NEMSweep.Web.Services.Insights
@inject ArtifactLoader ArtifactLoader
@inject SweepManifestLoader SweepManifestLoader
@inject SweepIndexLoader SweepIndexLoader

<PageTitle>NEMSweep</PageTitle>

<div class="home-page">
    <header class="hero">
        <div class="shell">
            <p class="eyebrow">Open source &middot; techno-economic grid analysis &middot; policy and investment cases</p>
            <h1>Define your energy assets. Stress-test them. Understand the impacts.</h1>
            <p class="lead">
                NEMSweep is an open-source dispatch framework that lets policy and investment
                professionals run low-fidelity models of the grid with regional generation,
                transmission and storage assets. Those assets can be stress-tested against
                user-defined loads, giving fast feedback on the challenges faced as the world
                transitions to renewables and demand for power grows. Understand firming
                shortfalls, reliability challenges, and economics at your desktop.
            </p>

            @* The headline finding, read live from the published sweep rather than written down,
               so re-running the sweep updates the claim instead of dating it. *@
            @if (BreakingPoint is { } breaking)
            {
                <p class="hero-claim">
                    <span>In a published sweep</span>
                    @breaking
                </p>
            }

            <div class="hero-actions">
                <a class="button-primary" href="@(PrimarySweepRoute ?? "regions")">
                    See the possibilities
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                </a>
                <a class="button-secondary"
                   href="@DocumentationLinks.LlmWorkflow"
                   target="_blank"
                   rel="noopener noreferrer">
                    <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" />
                    Get started
                </a>
            </div>

            @if (_analysis is not null)
            {
                <div class="hero-metrics">
                    <p class="figure-label">The Australian National Electricity Market (NEM) baseline run &middot; @ScopeShort</p>
                    <MetricStrip Items="@HeadlineMetrics"
                                 AriaLabel="Baseline run headline figures"
                                 Style="--metric-value-size: 1.45rem;" />
                </div>
            }
        </div>
    </header>

    <section id="problem" class="section" aria-labelledby="problem-heading">
        <div class="shell">
            <div class="section-heading">
                <p class="section-number">01</p>
                <div>
                    <p class="section-label">Why this exists</p>
                    <h2 id="problem-heading">Most modelling of the transition is inaccessible and demands your trust</h2>
                </div>
            </div>

            <div class="ruled-list">
                <article>
                    <h3>Open source code, closed ecosystem</h3>
                    <p>
                        Even when higher-fidelity models are made publicly available to conduct
                        techno-economic analysis of energy markets, they may require proprietary
                        licences to run and a university-level understanding of concepts such as
                        linear programming.
                    </p>
                </article>
                <article>
                    <h3>A headline number that improves as the system fails</h3>
                    <p>
                        Cost per megawatt-hour is measured against the energy actually served, so
                        demand the grid never met simply leaves the denominator. Quote that figure
                        alone and a system in shortfall reads as one getting cheaper.
                    </p>
                </article>
                <article>
                    <h3>Assumptions that drift without anyone noticing</h3>
                    <p>
                        A model's constants get tweaked for one run and the documentation never
                        catches up, so a report can go stale silently and nobody downstream can tell.
                    </p>
                </article>
            </div>

            <p class="pull">
                NEMSweep answers each of these directly. Its core model is open-source, open to
                scrutiny and well documented, and it hands control back to the policy and investment
                professional: the asset, resource and economic inputs, and the assumptions they
                carry. Cost is always reported beside the unserved energy behind it. Dispatch is
                simulated per region and reported per region rather than blended into a national
                figure.
            </p>
        </div>
    </section>

    @* Why a sweep is worth running, stated as the questions one answers. Each answer column is
       filled from the published sweep's own index where it has loaded, so the section is a
       demonstration rather than a claim. *@
    <section id="why-sweep" class="section" aria-labelledby="why-sweep-heading">
        <div class="shell">
            <div class="section-heading">
                <p class="section-number">02</p>
                <div>
                    <p class="section-label">Sweep the scenario space</p>
                    <h2 id="why-sweep-heading">One run tells you what happened. A sweep tells you when it breaks.</h2>
                </div>
                <p>
                    A single scenario answers one question at one value. Hold everything else
                    constant, move one input, and you answer a more useful one. Raise the penetration
                    of intermittent renewables, increase demand, add an interconnector or more
                    storage: can the grid still meet demand, and what does each step cost?
                </p>
            </div>

            <ol class="question-list">
                @foreach (SweepQuestion question in Questions)
                {
                    <li>
                        <p class="question-ask">@question.Ask</p>
                        <p class="question-reports">
                            <span>Reported as</span>
                            @question.Reports
                        </p>
                        @if (question.Answer is { } answer)
                        {
                            <p class="question-answer">
                                <span>In a published sweep</span>
                                @answer
                            </p>
                        }
                    </li>
                }
            </ol>

            <p class="pull">
                None of these are answerable from one run, and none of them require a new model.
                They require the same model run again along one axis.
            </p>
        </div>
    </section>

    @* An empty manifest legitimately means "no sweeps yet" and the section is omitted. A manifest
       that could not be read is different, and says so rather than quietly hiding navigation. *@
    @if (_manifestState.Status is ArtifactLoadStatus.Failed or ArtifactLoadStatus.InvalidData
        or ArtifactLoadStatus.NotFound)
    {
        <section id="sweeps" class="section">
            <div class="shell">
                <div class="section-heading">
                    <p class="section-number">03</p>
                    <div>
                        <p class="section-label">Published sweeps</p>
                        <h2>Compare runs across one varying input</h2>
                    </div>
                </div>
                <ArtifactLoadStateView State="_manifestState"><span /></ArtifactLoadStateView>
            </div>
        </section>
    }
    else if (_sweeps.Count > 0)
    {
        @* The one band on the page that inverts. A sweep is the product, so it gets the weight. *@
        <section id="sweeps" class="section sweep-band" aria-labelledby="sweeps-heading">
            <div class="shell">
                <div class="section-heading">
                    <p class="section-number">03</p>
                    <div>
                        <p class="section-label">Published sweeps</p>
                        <h2 id="sweeps-heading">Explore the types of questions you can ask with NEMSweep</h2>
                    </div>
                    <p>
                        A sweep is not a chart of summary figures. Each point is a complete dispatch
                        run you can open, read hour by hour, and compare against any other point.
                    </p>
                </div>

                <div class="sweep-list">
                    @foreach (SweepSummary summary in _sweeps)
                    {
                        <a class="sweep-entry" href="@SweepPaths.PageRoute(summary.Index.SweepId)">
                            <div class="sweep-entry-head">
                                <p class="sweep-entry-kind">@summary.Index.Axis.Label · @summary.Index.Axis.Unit</p>
                                <h3>@summary.Index.Name</h3>
                                @if (summary.Analysis.Findings.Count > 0)
                                {
                                    <p class="sweep-entry-finding">@summary.Analysis.Findings[0].Headline</p>
                                }
                            </div>
                            <dl class="sweep-entry-facts">
                                <div>
                                    <dt>Scenarios</dt>
                                    <dd>@summary.Index.Points.Length.ToString("N0")</dd>
                                </div>
                                @if (summary.Analysis.First is { } first && summary.Analysis.Last is { } last)
                                {
                                    <div>
                                        <dt>Levelised cost</dt>
                                        <dd>@PlotFormat.Money(first.Scalars.SlcoeAudPerMwh) → @PlotFormat.Money(last.Scalars.SlcoeAudPerMwh)</dd>
                                    </div>
                                    <div>
                                        <dt>Annual cost</dt>
                                        <dd>@PlotFormat.MoneyTotal((decimal)first.TotalAnnualCostAud) → @PlotFormat.MoneyTotal((decimal)last.TotalAnnualCostAud)</dd>
                                    </div>
                                    @* Both shown beside the cost figures deliberately. Storage is
                                       rebuilt until the run holds the reliability standard, so a run
                                       can report as within target only because it built its way there.
                                       Unserved demand also leaves the levelised-cost denominator, so
                                       a sweep can read as getting cheaper while the grid fails.
                                       The sizing outcome carries the rest: notRequired means the fleet
                                       held, resized means storage was built to hold it, and anything
                                       else means storage stopped closing the gap, so what is left is
                                       generation or transmission investment. Which of the two is not
                                       something sizing decides: only energyLimited proves a system-wide
                                       energy shortfall, and the others report a bound the search hit. *@
                                    @if (StorageBuild(first, last) is { } storageBuild)
                                    {
                                        <div>
                                            <dt>Storage energy built</dt>
                                            <dd>@storageBuild</dd>
                                        </div>
                                    }
                                    <div>
                                        <dt>Unserved energy</dt>
                                        <dd>@UnservedShare(first) → @UnservedShare(last)</dd>
                                    </div>
                                }
                                @if (summary.Analysis.ConstrainedPoints.Count > 0)
                                {
                                    <div class="sweep-entry-constraint">
                                        <dt>Without results</dt>
                                        <dd>@summary.Analysis.ConstrainedPoints.Count.ToString("N0") runs</dd>
                                    </div>
                                }
                            </dl>
                            <span class="sweep-entry-open">
                                Open the sweep
                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                            </span>
                        </a>
                    }
                </div>

                <div class="sweep-invitation">
                    <div>
                        <h3>Design your own study</h3>
                        <p>
                            Define a baseline scenario and a set of points that vary from it. The
                            runner fans out the full year at every point and lines them up along one
                            axis.
                        </p>
                    </div>
                    <a class="button-invert"
                       href="@DocumentationLinks.LlmWorkflow"
                       target="_blank"
                       rel="noopener noreferrer">
                        Design a sweep
                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                    </a>
                </div>
            </div>
        </section>
    }

    @if (_system is not null && _analysis is not null)
    {
        <section id="case-study" class="section" aria-labelledby="headline-heading">
            <div class="shell">
                <div class="section-heading">
                    <p class="section-number">04</p>
                    <div>
                        <p class="section-label">The baseline scenario</p>
                        <h2 id="headline-heading">Australia's National Electricity Market, dispatched for a year</h2>
                    </div>
                    <p>@ScopeSentence</p>
                </div>

                @if (_analysis.SystemMix.TotalMwh > 0)
                {
                    <figure class="figure">
                        <MixBar Segments="@_analysis.SystemMix.Segments()"
                                Label="Delivered energy by technology"
                                Detail="@($"{PlotFormat.Compact(_analysis.SystemMix.TotalMwh)} MWh delivered")"
                                AriaLabel="System delivered generation by technology" />
                        <figcaption>
                            Figure 1 &middot; Delivered energy by technology across the baseline year.
                            Every scenario above departs from this fleet.
                        </figcaption>
                    </figure>
                }

                <div class="inline-links">
                    <a href="regions">Compare the states</a>
                    <a href="dispatch">Open the hourly dispatch</a>
                </div>
            </div>
        </section>

        <div class="shell">
            <FindingCards Findings="@_analysis.Findings"
                          Eyebrow="Baseline insights"
                          Heading="What the baseline run found"
                          Description="Generated from the run's own figures each time this page loads, not written by hand. The most significant are shown here; the comparison page carries them all with the tables behind them."
                          Limit="3"
                          EvidenceHref="regions"
                          EvidenceText="See the figures behind this"
                          Class="home-findings" />
        </div>
    }
    else
    {
        @* Loading has a spinner and every other non-success state says why. Dropping the section
           silently would leave the page looking as though the run simply has no headline. *@
        <section id="case-study" class="section" aria-labelledby="headline-heading">
            <div class="shell">
                <div class="section-heading">
                    <p class="section-number">04</p>
                    <div>
                        <p class="section-label">The baseline scenario</p>
                        <h2 id="headline-heading">Australia's National Electricity Market, dispatched for a year</h2>
                    </div>
                </div>
                <ArtifactLoadStateView State="_systemState"><span /></ArtifactLoadStateView>
            </div>
        </section>
    }

    @* What the model can do, read out of the artifacts rather than described in prose, so this
       section moves when the model does instead of going quietly stale. *@
    @if (_modelState is not null)
    {
        <section id="method" class="section" aria-labelledby="state-heading">
            <div class="shell">
                <div class="section-heading">
                    <p class="section-number">05</p>
                    <div>
                        <p class="section-label">How it works</p>
                        <h2 id="state-heading">What the dispatch model does</h2>
                    </div>
                    <p>
                        Every line below is read from the artifacts the latest run produced, not
                        written by hand, so it reflects what the model actually did. The NEM is
                        modelled as its five regional grids at hourly resolution; which regions a
                        scenario includes, and the demand, fleet, storage and interconnectors in
                        each, are yours to define.
                    </p>
                </div>

                <ul class="capabilities">
                    @foreach (ModelCapability capability in _modelState.Capabilities)
                    {
                        <li class="@(capability.IsPresent ? "is-present" : "is-absent")">
                            <MudIcon Icon="@(capability.IsPresent ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked)"
                                     Size="Size.Small" />
                            <span>
                                <strong>@capability.Name</strong>
                                <small>@capability.Detail</small>
                            </span>
                        </li>
                    }
                </ul>
            </div>
        </section>
    }

    <section class="section" aria-labelledby="explore-heading">
        <div class="shell">
            <div class="section-heading">
                <p class="section-number">06</p>
                <div>
                    <p class="section-label">Trace it back</p>
                    <h2 id="explore-heading">Every result rests on a published input</h2>
                </div>
                <p>
                    Each result on this site names the exact artifact bytes it was computed from.
                    These are those inputs, and the method behind them.
                </p>
            </div>

            <div class="explore-links">
                <a href="regions">
                    <span>
                        <strong>System and states</strong>
                        <small>Where the cost, the spill and the shortfall actually sit</small>
                    </span>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
                </a>
                <a href="dispatch">
                    <span>
                        <strong>Hourly dispatch</strong>
                        <small>Generation, storage, reliability, and annual system cost</small>
                    </span>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
                </a>
                <a href="inputs/demand">
                    <span>
                        <strong>Operational demand</strong>
                        <small>Actual demand by year, month, or day</small>
                    </span>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
                </a>
                <a href="inputs/weather">
                    <span>
                        <strong>Weather resources</strong>
                        <small>Solar, wind, temperature, and modelled generation</small>
                    </span>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
                </a>
                <a href="inputs/generation">
                    <span>
                        <strong>Generation fleet</strong>
                        <small>Installed capacity and source units by technology</small>
                    </span>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
                </a>
                <a href="@DocumentationLinks.LlmWorkflow" target="_blank" rel="noopener noreferrer">
                    <span>
                        <strong>Design a sweep with an LLM</strong>
                        <small>The published contract a model can run against, and the guardrails</small>
                    </span>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
                </a>
            </div>
        </div>
    </section>

    <section class="section section-close" aria-labelledby="close-heading">
        <div class="shell">
            <div class="section-heading">
                <p class="section-number">07</p>
                <div>
                    <p class="section-label">Before you quote a figure</p>
                    <h2 id="close-heading">Three things these numbers are not</h2>
                </div>
            </div>

            <div class="claims-band">
                <p class="claim">
                    <strong>Not a forecast.</strong>
                    The gap between two scenarios is the trustworthy output; any single level carries
                    the model's assumptions with it.
                </p>
                <p class="claim">
                    <strong>Not a bill.</strong>
                    These are build-and-run costs. Retail, network and scheme costs are not included.
                    The levelised cost figure (SLCoE, system levelised cost of electricity) is not a
                    retail price anyone pays.
                </p>
                <p class="claim">
                    <strong>Not unexamined.</strong>
                    Every figure traces to a published run and to an
                    <a href="@DocumentationLinks.Assumptions" target="_blank" rel="noopener noreferrer">assumptions register</a>
                    a test suite checks against the code on every change.
                </p>
            </div>

            <div class="docs-cta">
                <p>
                    The guide, the concept pages behind dispatch and storage sizing, the full
                    assumptions and limitations register, and how to run your own sweeps with an LLM
                    all live on their own site.
                </p>
                <div class="docs-cta-actions">
                    <a class="button-primary"
                       href="@DocumentationLinks.Home"
                       target="_blank"
                       rel="noopener noreferrer">
                        <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Small" />
                        Open the documentation
                    </a>
                    <a class="button-secondary"
                       href="@DocumentationLinks.Limitations"
                       target="_blank"
                       rel="noopener noreferrer">
                        <MudIcon Icon="@Icons.Material.Filled.Rule" Size="Size.Small" />
                        Assumptions and limitations
                    </a>
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    private List<SweepSummary> _sweeps = [];
    private ArtifactLoadState _manifestState = ArtifactLoadState.Loading();
    private ArtifactLoadState _systemState = ArtifactLoadState.Loading();
    private SystemFacts? _system;
    private int _systemSchemaVersion;
    private SystemAnalysis? _analysis;
    private ModelState? _modelState;

    /// <summary>One question a sweep answers, what reports it, and what the published sweep said.</summary>
    private sealed record SweepQuestion(string Ask, string Reports, string? Answer);

    /// <summary>
    /// The first sweep's own headline: the axis value at which the reliability standard stops
    /// holding. This is the most arresting thing the model produces and it belongs in the hero,
    /// but it is a result, so it is read from the sweep index rather than written into the copy.
    /// </summary>
    private string? BreakingPoint
    {
        get
        {
            SweepAnalysis? sweep = _sweeps.FirstOrDefault()?.Analysis;
            SweepRun? breach = sweep?.Runs.FirstOrDefault(run => run.OutsideReliabilityTarget);
            return sweep is null || breach is null
                ? null
                : $"the NEM holds its reliability standard up to {PlotFormat.Compact(breach.AxisValue)} "
                    + $"{sweep.AxisUnit} of {sweep.AxisLabel.ToLowerInvariant()}. Past that, building "
                    + "more storage stops closing the gap.";
        }
    }

    /// <summary>The sweep the hero's primary action opens, once a sweep index has loaded.</summary>
    private string? PrimarySweepRoute => _sweeps.Count > 0
        ? SweepPaths.PageRoute(_sweeps[0].Index.SweepId)
        : null;

    private string ScopeSentence => _system is null
        ? string.Empty
        : $"{RegionNames.StateList(_system.RegionIds)}, "
            + $"{_system.PeriodStart:MMM yyyy} to {_system.PeriodEnd.AddTicks(-1):MMM yyyy}, "
            + $"simulated at {_system.Resolution.TotalHours:N0}-hour resolution against a typical "
            + "meteorological year.";

    private string ScopeShort => _system is null
        ? string.Empty
        : $"{_system.RegionIds.Length} regions, {_system.PeriodStart:MMM yyyy} to {_system.PeriodEnd.AddTicks(-1):MMM yyyy}";

    private IReadOnlyList<MetricStripItem> HeadlineMetrics => _analysis is null
        ?
        []
        :
        [
            new("Levelised cost", PlotFormat.Money(_analysis.Result.Cost.SlcoeAudPerMwh), "AUD/MWh served"),
            new("Annual system cost", PlotFormat.MoneyTotal(_analysis.Result.Cost.TotalAnnualisedCostAud), "generation, storage and transmission"),
            new("Renewable share", RenewableShare, "of delivered energy"),
            new("Reliability", ReliabilityHeadline, ReliabilityDetail),
        ];

    /// <summary>
    /// The four questions the site exists to answer, each paired with the measure that answers it
    /// and, where the sweep index has loaded, what the published sweep actually reported. The
    /// answers are read from the sweep rather than written down, so a sweep that is re-run with
    /// different numbers updates this section instead of contradicting it.
    /// </summary>
    private IReadOnlyList<SweepQuestion> Questions
    {
        get
        {
            SweepAnalysis? sweep = _sweeps.FirstOrDefault()?.Analysis;
            SweepRun? first = sweep?.First;
            SweepRun? last = sweep?.Last;
            SweepRun? breach = sweep?.Runs.FirstOrDefault(run => run.OutsideReliabilityTarget);
            string unit = sweep?.AxisUnit ?? string.Empty;
            int breached = sweep?.Runs.Count(run => run.OutsideReliabilityTarget) ?? 0;

            return
            [
                new(
                    "Does the fleet we already have still hold?",
                    "Storage sizing outcome and unserved energy, checked per region and for the system at every point on the axis.",
                    breach is null
                        ? sweep is null ? null : "every published scenario held the standard."
                        : $"the standard holds up to {PlotFormat.Compact(breach.AxisValue)} {unit}, and is missed from there on."),
                new(
                    "If it does not, how much storage has to be built?",
                    "When a scenario as configured misses the reliability standard, the model grows storage to try to hold it. Installed storage energy before and after sizing, for every scenario in the sweep.",
                    first is not null && last is not null && StorageBuild(first, last) is { } build
                        ? $"storage grows {build} across the axis."
                        : null),
                new(
                    "What does that do to the cost of energy?",
                    "Levelised cost per MWh served and the whole annual system bill, reported side by side.",
                    first is not null && last is not null
                        ? $"the annual bill moves {PlotFormat.MoneyTotal((decimal)first.TotalAnnualCostAud)} → "
                            + $"{PlotFormat.MoneyTotal((decimal)last.TotalAnnualCostAud)}."
                        : null),
                new(
                    "Where does storage stop being the answer?",
                    "The scenarios that miss the standard even after sizing has built all the storage it is allowed to.",
                    sweep is null
                        ? null
                        : breached == 0
                            ? "no published scenario reached that point."
                            : $"{breached:N0} of {sweep.Runs.Count:N0} scenarios miss the standard even after resizing, "
                                + "so what is left is generation or transmission."),
            ];
        }
    }

    /// <summary>
    /// Read from the sizing outcome rather than <c>Reliability.WithinTarget</c>: the target is
    /// satisfiable by having built the storage that satisfies it, so the raw verdict cannot
    /// distinguish an existing fleet that already held from one that had to be rebuilt first. Under
    /// a "what happens when the data centres arrive?" headline, "within target" alone reads as
    /// reassurance the run does not support.
    /// </summary>
    private string ReliabilityHeadline => _analysis!.Result.StorageSizing.Outcome switch
    {
        StorageSizingOutcome.NotRequired => "Existing fleet holds",
        StorageSizingOutcome.Resized => "Storage grown to comply",
        _ => "Cannot meet target",
    };

    private string ReliabilityDetail => _analysis!.Result.StorageSizing.Outcome switch
    {
        StorageSizingOutcome.Resized =>
            $"grown by {PlotFormat.Compact(_analysis.Result.StorageSizing.FinalEnergyMwh - _analysis.Result.StorageSizing.InitialEnergyMwh)} MWh to reach "
                + $"{PlotFormat.Share(AllowanceUsed, 0)} of the unserved-energy allowance used",
        StorageSizingOutcome.NotRequired =>
            $"{PlotFormat.Share(AllowanceUsed, 0)} of the unserved-energy allowance used",
        _ =>
            $"even after resizing, {PlotFormat.Share(AllowanceUsed, 0)} of the unserved-energy allowance used",
    };

    private string RenewableShare => _analysis!.SystemMix.TotalMwh > 0
        ? PlotFormat.Share(_analysis.SystemMix.RenewableShare)
        : "—";

    /// <summary>
    /// A sweep run's unserved energy as a share of demand. Held to three decimals because the
    /// reliability standard itself is 0.002%, so rounding to the usual one decimal would show every
    /// run in a sweep as 0.0% right up to the point the grid is failing outright.
    /// </summary>
    private static string UnservedShare(SweepRun run) =>
        run.Scalars.UnservedEnergyPercentageOfDemand.ToString("N3", CultureInfo.InvariantCulture) + "%";

    /// <summary>
    /// How far the sweep drove the storage fleet, read from the sizing outcome rather than from
    /// the reliability verdict. A run counts as within target once sizing has grown storage enough
    /// to get it there, so the verdict alone cannot distinguish a fleet that held from one that
    /// had to be rebuilt first. Omitted when the sweep's runs carry no sizing outcome.
    /// </summary>
    /// <remarks>
    /// Formatted plainly rather than through <see cref="PlotFormat.Compact"/>: these two figures
    /// straddle its hundred-thousand threshold, so compacting would print one as 14,387 and the
    /// other as 109k in the same row.
    /// </remarks>
    private static string? StorageBuild(SweepRun first, SweepRun last) =>
        first.Point.StorageSizing is { } start && last.Point.StorageSizing is { } end
            ? $"{start.FinalEnergyMwh.ToString("N0", CultureInfo.CurrentCulture)} → "
                + $"{end.FinalEnergyMwh.ToString("N0", CultureInfo.CurrentCulture)} MWh"
            : null;

    private double AllowanceUsed => _analysis!.Result.Reliability.TargetUsePercentageOfDemand <= 0
        ? 0
        : _analysis.Result.Reliability.AchievedUsePercentageOfDemand
            / _analysis.Result.Reliability.TargetUsePercentageOfDemand;

    protected override async Task OnInitializedAsync()
    {
        // The system result is what the page leads with, so it is fetched first and rendered before
        // the sweep indexes are walked. Nothing here plots an interval series, so this reads the
        // overview artifact rather than the full result and the landing page costs about 19 KB
        // instead of two megabytes.
        ArtifactLoadResult<SystemDispatchOverviewDTO> system =
            await ArtifactLoader.LoadAsync<SystemDispatchOverviewDTO>("data/results-overview.json");
        _systemState = system.State;
        if (system.IsSuccess)
        {
            _systemSchemaVersion = system.Value!.SchemaVersion;
            _system = SystemFacts.From(system.Value!);
            _analysis = SystemAnalysis.Build(_system);
            StateHasChanged();
        }

        ArtifactLoadResult<SweepManifestDTO> manifest = await SweepManifestLoader.LoadAsync();
        _manifestState = manifest.State;
        if (!manifest.IsSuccess)
        {
            return;
        }

        foreach (SweepManifestEntryDTO entry in manifest.Value!.Sweeps)
        {
            ArtifactLoadResult<SweepIndexDTO> index =
                await SweepIndexLoader.LoadAsync(SweepPaths.IndexPath(entry));
            if (index.IsSuccess)
            {
                _sweeps.Add(new SweepSummary(index.Value!, SweepAnalysis.Build(index.Value!)));
            }
        }

        // Stated once both halves are in hand: what the model does is partly a question about the
        // dispatch run and partly about how many sweeps sit behind it.
        if (_system is not null)
        {
            _modelState = ModelState.From(
                _system,
                _systemSchemaVersion,
                [.. _sweeps.Select(sweep => sweep.Index)]);
        }
    }

    private sealed record SweepSummary(SweepIndexDTO Index, SweepAnalysis Analysis);
}
