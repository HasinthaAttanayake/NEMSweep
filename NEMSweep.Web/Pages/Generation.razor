@page "/inputs/generation"
@using NEMSweep.Contracts
@using System.Globalization
@inject ArtifactLoader ArtifactLoader

<PageTitle>Generation fleet</PageTitle>

<main class="generation-page">
    <PageHeader Eyebrow="AEMO generation information" Title="Generation fleet"
                Style="--page-header-padding-bottom: 1.35rem; --page-header-border: var(--color-border-generation); --page-header-title-size: clamp(2.1rem, 4vw, 3.6rem)">
        <ScopeContent>
            @if (_data is not null)
            {
                <ScopeLine Region="@_data.SourceFile"
                           Period="@($"{_data.Rows.Length:N0} source units")"
                           BaselineGlobal="true" />
            }
        </ScopeContent>
        <TrailingContent>
            @if (_loadState.Status == ArtifactLoadStatus.Success)
            {
                <div class="filters" aria-label="Generation filters">
                <label>
                    <span>Date</span>
                    <input type="date"
                           value="@_selectedDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                           @onchange="OnDateChanged" />
                </label>
                <label>
                    <span>Region</span>
                    <select value="@_selectedRegion" @onchange="OnRegionChanged">
                        <option value="All">All NEM regions</option>
                        @foreach (string region in _regions)
                        {
                            <option value="@region">@region</option>
                        }
                    </select>
                </label>
                <label>
                    <span>Minimum site capacity</span>
                    <div class="number-field">
                        <input type="number"
                               min="0"
                               step="1"
                               value="@_minimumSiteCapacityMw.ToString(CultureInfo.InvariantCulture)"
                               @onchange="OnMinimumCapacityChanged" />
                        <span>MW AC</span>
                    </div>
                </label>
                </div>
            }
        </TrailingContent>
    </PageHeader>

    <ArtifactLoadStateView State="_loadState">
        <MetricStrip Items="@GenerationMetrics" AriaLabel="Filtered generation summary"
                     Style="--metric-border: var(--color-border-generation); --metric-muted: var(--color-muted-generation); --metric-label-size: .78rem; --metric-value-size: 1.8rem; --metric-value-margin: .15rem .3rem 0 0" />

        <p class="filter-summary">
            In-service units active on @_selectedDate.ToString("d MMMM yyyy") at sites of
            @_minimumSiteCapacityMw.ToString("N0") MW AC or greater
            @(_selectedRegion == "All" ? "across the NEM" : $"in {_selectedRegion}").
        </p>

        @if (_technologyAggregates.Count == 0)
        {
            <MudAlert Severity="Severity.Info">No units match the selected filters.</MudAlert>
        }
        else
        {
            <section class="visual-grid" aria-label="Technology visualisations">
                <ChartFrame Heading="AC capacity share" SectionIndex="01"
                            Class="visual-panel" Unit="MW AC · nearest 0.1 MW"
                            Style="--chart-frame-padding-top: 0; --chart-frame-heading-padding-bottom: .65rem; --chart-frame-heading-border: 2px solid var(--color-ink); --chart-frame-heading-size: 1.15rem; --accent: var(--color-muted-generation); --accent-soft: transparent; --color-unit-border: transparent">
                    <MudChart T="double"
                              ChartType="ChartType.Donut"
                              ChartSeries="_acShareSeries"
                              ChartLabels="_donutLabels"
                              ChartOptions="_donutOptions"
                              Width="100%"
                              Height="360px" />
                    <ul class="technology-legend" aria-label="AC capacity by technology">
                        @foreach (TechnologyAggregate technology in _technologyAggregates)
                        {
                            <li>
                                <span class="legend-swatch" style="background-color: @TechnologyColor(technology.TechnologyType)"></span>
                                <span>@technology.TechnologyType</span>
                            </li>
                        }
                    </ul>
                </ChartFrame>

                <ChartFrame Heading="Nameplate comparison" SectionIndex="02"
                            Class="visual-panel" Unit="MW · nearest 0.1 MW"
                            Style="--chart-frame-padding-top: 0; --chart-frame-heading-padding-bottom: .65rem; --chart-frame-heading-border: 2px solid var(--color-ink); --chart-frame-heading-size: 1.15rem; --accent: var(--color-muted-generation); --accent-soft: transparent; --color-unit-border: transparent">
                    <MudChart T="double"
                              ChartType="ChartType.Bar"
                              ChartSeries="_capacitySeries"
                              ChartLabels="_technologyLabels"
                              Width="100%"
                              Height="360px" />
                </ChartFrame>
            </section>

            <section class="technology-section">
                <div class="section-heading">
                    <div><p class="section-index">03</p><h2>Technology breakdown</h2></div>
                    <span>Aggregates rounded to nearest 0.1 MW / MWh</span>
                </div>
                <div class="table-scroll">
                    <table class="aggregate-table">
                        <thead>
                            <tr>
                                <th class="expand-col"></th>
                                <th>Technology</th><th>Units</th><th>Sites</th>
                                <th>DC capacity (MW)</th><th>AC capacity (MW)</th><th>Storage (MWh)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (TechnologyAggregate technology in _technologyAggregates)
                            {
                                bool expanded = _expandedTechnologies.Contains(technology.TechnologyType);
                                <tr>
                                    <td class="expand-col">
                                        @if (technology.Details.Count > 0)
                                        {
                                            <button type="button" class="expand-toggle"
                                                    aria-expanded="@(expanded ? "true" : "false")"
                                                    aria-label="@($"{(expanded ? "Collapse" : "Expand")} {technology.TechnologyType} by detail")"
                                                    @onclick="@(() => ToggleTechnology(technology.TechnologyType))">
                                                @(expanded ? "−" : "+")
                                            </button>
                                        }
                                    </td>
                                    <th>@technology.TechnologyType</th>
                                    <td>@technology.UnitCount.ToString("N0")</td>
                                    <td>@technology.SiteCount.ToString("N0")</td>
                                    <td>@technology.CapacityDcMw.ToString("N1")</td>
                                    <td>@technology.CapacityAcMw.ToString("N1")</td>
                                    <td>@technology.StorageMwh.ToString("N1")</td>
                                </tr>
                                @if (expanded)
                                {
                                    @foreach (TechnologyDetailAggregate detail in technology.Details)
                                    {
                                        <tr class="aggregate-detail-row">
                                            <td class="expand-col"></td>
                                            <th>@detail.Detail</th>
                                            <td>@detail.UnitCount.ToString("N0")</td>
                                            <td>@detail.SiteCount.ToString("N0")</td>
                                            <td>@detail.CapacityDcMw.ToString("N1")</td>
                                            <td>@detail.CapacityAcMw.ToString("N1")</td>
                                            <td>@detail.StorageMwh.ToString("N1")</td>
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="source-section">
                <div class="section-heading">
                    <div><p class="section-index">04</p><h2>Filtered source table</h2></div>
                    <span>Columns A-Z</span>
                </div>
                <div class="source-search">
                    <input type="search"
                           placeholder="Search any column…"
                           value="@_sourceSearch"
                           @oninput="OnSourceSearchChanged" />
                    <span class="source-search-count">@_filteredRows.Count(RowMatchesSearch).ToString("N0") of @_filteredRows.Count.ToString("N0") rows</span>
                </div>
                <MudTable Items="_filteredRows" Filter="new Func<GenerationInformationRow, bool>(RowMatchesSearch)"
                          Dense="true" Hover="true" FixedHeader="true" Height="520px" RowsPerPage="25">
                    <HeaderContent>
                        <MudTh><MudTableSortLabel SortBy="new Func<GenerationInformationRow, object>(r => r.AemoSurveyId)">Survey ID</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<GenerationInformationRow, object>(r => r.SiteName)">Site</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<GenerationInformationRow, object>(r => r.AemoKciId ?? string.Empty)">KCI ID</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<GenerationInformationRow, object>(r => r.SiteOwner ?? string.Empty)">Owner</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<GenerationInformationRow, object>(r => r.Custodian ?? string.Empty)">Custodian</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<GenerationInformationRow, object>(r => r.Region)">Region</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<GenerationInformationRow, object>(r => r.MaxSiteCapacityAcMw ?? 0)">Max site AC</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<GenerationInformationRow, object>(r => r.GenInfoUnitId)">Unit ID</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<GenerationInformationRow, object>(r => r.UnitName ?? string.Empty)">Unit</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<GenerationInformationRow, object>(r => r.TechnologyType)">Technology</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<GenerationInformationRow, object>(r => r.TechnologyDetail ?? string.Empty)">Detail</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<GenerationInformationRow, object>(r => r.GasTurbineFuelType ?? string.Empty)">Gas fuel</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<GenerationInformationRow, object>(r => r.Duid ?? string.Empty)">DUID</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<GenerationInformationRow, object>(r => r.DispatchType ?? string.Empty)">Dispatch</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<GenerationInformationRow, object>(r => r.UnitCount ?? 0)">Unit count</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<GenerationInformationRow, object>(r => r.UnitCapacityDcMw ?? 0)">Unit DC</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<GenerationInformationRow, object>(r => r.UnitCapacityAcMw ?? 0)">Unit AC</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<GenerationInformationRow, object>(r => r.AggregateNameplateCapacityDcMw ?? 0)">Agg DC</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<GenerationInformationRow, object>(r => r.AggregateNameplateCapacityAcMw ?? 0)">Agg AC</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<GenerationInformationRow, object>(r => r.AggregateNameplateStorageCapacityMwh ?? 0)">Agg storage</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<GenerationInformationRow, object>(r => r.CommitmentStatus)">Status</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<GenerationInformationRow, object>(r => r.FullCommercialUseDate ?? DateOnly.MinValue)">Commercial use</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<GenerationInformationRow, object>(r => r.ExpectedClosureYear ?? 0)">Closure year</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<GenerationInformationRow, object>(r => r.ClosureDate ?? DateOnly.MinValue)">Closure date</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<GenerationInformationRow, object>(r => r.SurveyLastRequestedDate ?? DateOnly.MinValue)">Survey requested</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<GenerationInformationRow, object>(r => r.SurveyLatestUpdateDate ?? DateOnly.MinValue)">Survey updated</MudTableSortLabel></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.AemoSurveyId</MudTd><MudTd>@context.SiteName</MudTd><MudTd>@context.AemoKciId</MudTd><MudTd>@context.SiteOwner</MudTd>
                        <MudTd>@context.Custodian</MudTd><MudTd>@context.Region</MudTd><MudTd>@FormatNumber(context.MaxSiteCapacityAcMw)</MudTd><MudTd>@context.GenInfoUnitId</MudTd>
                        <MudTd>@context.UnitName</MudTd><MudTd>@context.TechnologyType</MudTd><MudTd>@context.TechnologyDetail</MudTd><MudTd>@context.GasTurbineFuelType</MudTd>
                        <MudTd>@context.Duid</MudTd><MudTd>@context.DispatchType</MudTd><MudTd>@FormatNumber(context.UnitCount)</MudTd><MudTd>@FormatNumber(context.UnitCapacityDcMw)</MudTd>
                        <MudTd>@FormatNumber(context.UnitCapacityAcMw)</MudTd><MudTd>@FormatNumber(context.AggregateNameplateCapacityDcMw)</MudTd><MudTd>@FormatNumber(context.AggregateNameplateCapacityAcMw)</MudTd><MudTd>@FormatNumber(context.AggregateNameplateStorageCapacityMwh)</MudTd>
                        <MudTd>@context.CommitmentStatus</MudTd><MudTd>@FormatDate(context.FullCommercialUseDate)</MudTd><MudTd>@context.ExpectedClosureYear</MudTd><MudTd>@FormatDate(context.ClosureDate)</MudTd>
                        <MudTd>@FormatDate(context.SurveyLastRequestedDate)</MudTd><MudTd>@FormatDate(context.SurveyLatestUpdateDate)</MudTd>
                    </RowTemplate>
                    <PagerContent><MudTablePager PageSizeOptions="@(new[] { 25, 50, 100 })" /></PagerContent>
                </MudTable>
            </section>
        }
    </ArtifactLoadStateView>
</main>

@code {
    private ArtifactLoadState _loadState = ArtifactLoadState.Loading();
    private GenerationInformationDTO? _data;
    private DateOnly _selectedDate = DateOnly.FromDateTime(DateTime.Today);
    private string _selectedRegion = "All";
    private double _minimumSiteCapacityMw = 30;
    private string[] _regions = [];
    private List<GenerationInformationRow> _filteredRows = [];
    private List<TechnologyAggregate> _technologyAggregates = [];
    private string[] _technologyLabels = [];
    private string[] _donutLabels = [];
    private double[] _acCapacityByTechnology = [];
    private List<ChartSeries<double>> _acShareSeries = [];
    private List<ChartSeries<double>> _capacitySeries = [];
    private DonutChartOptions _donutOptions = new()
    {
        ShowLegend = false,
        TooltipTitleFormat = "{{Y_VALUE}}",
    };
    private int _siteCount;
    private double _totalAcMw;
    private double _totalStorageMwh;
    private HashSet<string> _expandedTechnologies = [];
    private string _sourceSearch = string.Empty;

    private IReadOnlyList<MetricStripItem> GenerationMetrics =>
    [
        new("Included units", _filteredRows.Count.ToString("N0")),
        new("Sites", _siteCount.ToString("N0")),
        new("Nameplate AC", _totalAcMw.ToString("N1"), "MW · nearest 0.1 MW"),
        new("Storage", _totalStorageMwh.ToString("N1"), "MWh · nearest 0.1 MWh"),
    ];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ArtifactLoadResult<GenerationInformationDTO> loadResult =
                await ArtifactLoader.LoadAsync<GenerationInformationDTO>("data/generation-information.json");
            if (!loadResult.IsSuccess)
            {
                _loadState = loadResult.State;
                return;
            }

            _data = loadResult.Value!;
            _regions = _data.Rows.Select(row => row.Region).Distinct().Order().ToArray();
            ApplyFilters();
            _loadState = loadResult.State;
        }
        catch (Exception exception)
        {
            _loadState = ArtifactLoadState.Failed($"Error loading generation information: {exception.Message}");
        }
    }

    private void OnDateChanged(ChangeEventArgs args)
    {
        if (DateOnly.TryParseExact(args.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out DateOnly date))
        {
            _selectedDate = date;
            ApplyFilters();
        }
    }

    private void OnRegionChanged(ChangeEventArgs args)
    {
        _selectedRegion = args.Value?.ToString() ?? "All";
        ApplyFilters();
    }

    private void OnMinimumCapacityChanged(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out double capacity) && capacity >= 0)
        {
            _minimumSiteCapacityMw = capacity;
            ApplyFilters();
        }
    }

    private void ApplyFilters()
    {
        if (_data is null) return;

        _filteredRows = _data.Rows
            .Where(row => row.CommitmentStatus.Equals("In Service", StringComparison.OrdinalIgnoreCase))
            .Where(row => row.MaxSiteCapacityAcMw is double capacityMw
                && capacityMw >= _minimumSiteCapacityMw)
            .Where(row => _selectedRegion == "All" || row.Region == _selectedRegion)
            .Where(row => row.FullCommercialUseDate is not DateOnly commercialUseDate
                || commercialUseDate <= _selectedDate)
            .Where(row => row.ExpectedClosureYear is not int closureYear
                || _selectedDate.Year <= closureYear)
            .OrderBy(row => row.TechnologyType)
            .ThenBy(row => row.SiteName)
            .ToList();

        _technologyAggregates = _filteredRows
            .GroupBy(row => row.TechnologyType)
            .Select(group => new TechnologyAggregate(
                group.Key,
                group.Count(),
                group.Select(row => row.AemoSurveyId).Distinct().Count(),
                RoundAggregate(group.Sum(row => row.AggregateNameplateCapacityDcMw ?? 0)),
                RoundAggregate(group.Sum(row => row.AggregateNameplateCapacityAcMw ?? 0)),
                RoundAggregate(group.Sum(row => row.AggregateNameplateStorageCapacityMwh ?? 0)),
                BuildDetailAggregates(group)))
            .OrderByDescending(item => item.CapacityAcMw)
            .ToList();

        _siteCount = _filteredRows.Select(row => row.AemoSurveyId).Distinct().Count();
        _totalAcMw = RoundAggregate(_technologyAggregates.Sum(item => item.CapacityAcMw));
        _totalStorageMwh = RoundAggregate(_technologyAggregates.Sum(item => item.StorageMwh));
        _technologyLabels = _technologyAggregates.Select(item => item.TechnologyType).ToArray();
        _acCapacityByTechnology = _technologyAggregates.Select(item => item.CapacityAcMw).ToArray();
        _donutLabels = _technologyAggregates
            .Select(item => $"{item.TechnologyType}: {item.CapacityAcMw:N1} MW ({CapacityPercentage(item.CapacityAcMw):N1}%)")
            .ToArray();
        _acShareSeries =
        [
            new ChartSeries<double>
            {
                Name = "AC capacity",
                Data = _acCapacityByTechnology,
                TooltipTitleFormat = "{{X_VALUE}}",
                TooltipSubtitleFormat = string.Empty,
            },
        ];
        _donutOptions = new DonutChartOptions
        {
            ShowLegend = false,
            TooltipTitleFormat = "{{Y_VALUE}}",
            ChartPalette = _technologyAggregates
                .Select(item => TechnologyColor(item.TechnologyType))
                .ToArray(),
        };
        _capacitySeries =
        [
            new ChartSeries<double> { Name = "DC capacity", Data = _technologyAggregates.Select(item => item.CapacityDcMw).ToArray() },
            new ChartSeries<double> { Name = "AC capacity", Data = _acCapacityByTechnology },
        ];
    }

    private static double RoundAggregate(double value) =>
        Math.Round(value, 1, MidpointRounding.AwayFromZero);
    private static string FormatNumber(double? value) => value?.ToString("N2") ?? "—";
    private static string FormatDate(DateOnly? value) => value?.ToString("dd MMM yyyy") ?? "—";
    private double CapacityPercentage(double capacityMw) =>
        _totalAcMw == 0 ? 0 : capacityMw / _totalAcMw * 100;

    private static List<TechnologyDetailAggregate> BuildDetailAggregates(IEnumerable<GenerationInformationRow> rows) =>
        rows
            .GroupBy(row => string.IsNullOrWhiteSpace(row.TechnologyDetail) ? "Unspecified" : row.TechnologyDetail!)
            .Select(group => new TechnologyDetailAggregate(
                group.Key,
                group.Count(),
                group.Select(row => row.AemoSurveyId).Distinct().Count(),
                RoundAggregate(group.Sum(row => row.AggregateNameplateCapacityDcMw ?? 0)),
                RoundAggregate(group.Sum(row => row.AggregateNameplateCapacityAcMw ?? 0)),
                RoundAggregate(group.Sum(row => row.AggregateNameplateStorageCapacityMwh ?? 0))))
            .OrderByDescending(item => item.CapacityAcMw)
            .ToList();

    private void ToggleTechnology(string technologyType)
    {
        if (!_expandedTechnologies.Remove(technologyType))
        {
            _expandedTechnologies.Add(technologyType);
        }
    }

    private void OnSourceSearchChanged(ChangeEventArgs args)
    {
        _sourceSearch = args.Value?.ToString() ?? string.Empty;
    }

    /// <summary>
    /// One search box standing in for a search per column: every field a reader might filter by is
    /// folded into a single haystack, so a survey ID, a DUID and a closure year are all reachable
    /// from the same input without twenty-six boxes crowding an already dense header.
    /// </summary>
    private bool RowMatchesSearch(GenerationInformationRow row)
    {
        if (string.IsNullOrWhiteSpace(_sourceSearch))
        {
            return true;
        }

        string[] fields =
        [
            row.AemoSurveyId, row.SiteName, row.AemoKciId ?? "", row.SiteOwner ?? "", row.Custodian ?? "",
            row.Region, row.GenInfoUnitId, row.UnitName ?? "", row.TechnologyType, row.TechnologyDetail ?? "",
            row.GasTurbineFuelType ?? "", row.Duid ?? "", row.DispatchType ?? "", row.CommitmentStatus,
            FormatNumber(row.MaxSiteCapacityAcMw), FormatNumber(row.UnitCount), FormatNumber(row.UnitCapacityDcMw),
            FormatNumber(row.UnitCapacityAcMw), FormatNumber(row.AggregateNameplateCapacityDcMw),
            FormatNumber(row.AggregateNameplateCapacityAcMw), FormatNumber(row.AggregateNameplateStorageCapacityMwh),
            row.ExpectedClosureYear?.ToString(CultureInfo.InvariantCulture) ?? "",
            FormatDate(row.FullCommercialUseDate), FormatDate(row.ClosureDate),
            FormatDate(row.SurveyLastRequestedDate), FormatDate(row.SurveyLatestUpdateDate),
        ];
        return fields.Any(field => field.Contains(_sourceSearch, StringComparison.OrdinalIgnoreCase));
    }

    private static string TechnologyColor(string technologyType) => technologyType switch
    {
        "Coal" => "#3f474d",
        "Wind" => "#147d79",
        "Gas Turbine" => "#d06b28",
        "Solar PV" => "#e3aa18",
        "Hydro" => "#2878b8",
        "Battery Storage" => "#a94f76",
        _ => "#7b8790",
    };

    private sealed record TechnologyAggregate(
        string TechnologyType,
        int UnitCount,
        int SiteCount,
        double CapacityDcMw,
        double CapacityAcMw,
        double StorageMwh,
        List<TechnologyDetailAggregate> Details);

    private sealed record TechnologyDetailAggregate(
        string Detail,
        int UnitCount,
        int SiteCount,
        double CapacityDcMw,
        double CapacityAcMw,
        double StorageMwh);
}