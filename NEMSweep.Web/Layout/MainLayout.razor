@inherits LayoutComponentBase

<MudThemeProvider Theme="@AppTheme.Instance" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<a class="skip-link" href="#content">Skip to content</a>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @* This bar used to hold a single GitHub link. It is the one piece of chrome on every
               results page, so it carries the path from reading a result to running one instead. *@
            <a class="top-row-link"
               href="@DocumentationLinks.Home"
               target="_blank"
               rel="noopener noreferrer">
                <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Small" />
                Docs
            </a>
            <a class="top-row-link"
               href="https://github.com/HasinthaAttanayake/NEMSweep"
               target="_blank"
               rel="noopener noreferrer">
                <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Small" />
                GitHub
            </a>
            <a class="top-row-cta"
               href="@DocumentationLinks.LlmWorkflow"
               target="_blank"
               rel="noopener noreferrer">
                <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" />
                Run your own scenario
            </a>
        </div>

        <article class="content px-4" id="content" tabindex="-1">
            @Body
        </article>
    </main>
</div>
