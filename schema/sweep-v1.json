  "$id": "https://nemsweep.com/schemas/sweep-definition.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "axis": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "minLength": 1,
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "label",
        "unit"
      ],
      "type": "object"
    },
    "baselineConfigPath": {
      "minLength": 1,
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "points": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "axisValue": {
            "type": "number"
          },
          "label": {
            "minLength": 1,
            "type": "string"
          },
          "overrides": {
            "$ref": "#/$defs/scenarioOverrides"
          },
          "pointId": {
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string"
          }
        },
        "required": [
          "pointId",
          "axisValue",
          "label",
          "overrides"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schemaVersion": {
      "const": 1
    },
    "sweepId": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "sweepId",
    "name",
    "axis",
    "baselineConfigPath",
    "points"
  ],
  "title": "NEMSweep sweep definition",
  "type": "object"
}
