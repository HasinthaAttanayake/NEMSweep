            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "demandSourceFiles"
      ],
      "type": "object"
    },
    "scenario": {
      "properties": {
        "aggregation": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "periodEnd": {
          "format": "date-time",
          "type": "string"
        },
        "periodStart": {
          "format": "date-time",
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "resolution": {
